
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Admission Enquiry | Maa Maturani Devi Pharmacy College</title>

  <meta
    name="description"
    content="Contact Maa Maturani Devi Pharmacy College for course and admission enquiries."
  >

  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
  >

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
  >

  <style>
    /* ===============================
       RESET AND BASE
    =============================== */

    *,
    *::before,
    *::after {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
      scroll-padding-top: 125px;
    }

    body {
      margin: 0;
      padding: 0;
      width: 100%;
      min-width: 0;
      min-height: 100vh;
      font-family: "Inter", sans-serif;
      line-height: 1.6;
      color: #17384e;
      background: linear-gradient(145deg, #f7faff, #eaf2f8);
      overflow-x: clip;
    }

    input,
    select,
    textarea,
    button {
      font: inherit;
    }

    button {
      -webkit-tap-highlight-color: transparent;
    }

    /* ===============================
       PAGE LAYOUT
    =============================== */

    .enquiry-page {
      width: 100%;
      min-height: calc(100vh - 100px);
      padding: 36px 20px 60px;
    }

    .enquiry-wrapper {
      width: 100%;
      max-width: 620px;
      margin: 0 auto;
      min-width: 0;
    }

    .enquiry-card {
      width: 100%;
      min-width: 0;
      padding: clamp(22px, 4vw, 38px);
      background: #ffffff;
      border: 1px solid #e8eef4;
      border-radius: 28px;
      box-shadow: 0 20px 55px rgba(22, 57, 80, 0.10);
    }

    /* ===============================
       HEADER
    =============================== */

    .card-header {
      display: flex;
      align-items: center;
      gap: 14px;
      margin-bottom: 8px;
      min-width: 0;
    }

    .header-icon {
      flex: 0 0 52px;
      width: 52px;
      height: 52px;
      display: grid;
      place-items: center;
      color: #ffffff;
      font-size: 23px;
      background: linear-gradient(135deg, #1680a6, #124e70);
      border-radius: 16px;
    }

    .card-header h1 {
      margin: 0;
      min-width: 0;
      font-size: clamp(1.5rem, 4vw, 2rem);
      line-height: 1.25;
      font-weight: 800;
      color: #103e5c;
      overflow-wrap: anywhere;
    }

    .subhead {
      margin: 12px 0 28px;
      padding: 10px 13px;
      border-left: 4px solid #2584a7;
      border-radius: 0 10px 10px 0;
      color: #536b7c;
      background: #f4f9fc;
      font-size: 0.92rem;
      overflow-wrap: anywhere;
    }

    .subhead i {
      color: #1d7a9c;
      margin-right: 7px;
    }

    /* ===============================
       SUCCESS / SERVER MESSAGES
    =============================== */

    .form-alert {
      display: none;
      margin-bottom: 20px;
      padding: 14px 16px;
      border-radius: 12px;
      font-size: 0.92rem;
      overflow-wrap: anywhere;
    }

    .form-alert.show {
      display: flex;
      align-items: flex-start;
      gap: 10px;
    }

    .form-alert i {
      margin-top: 4px;
      flex-shrink: 0;
    }

    .form-alert.success {
      color: #155c3b;
      background: #e8f8ef;
      border: 1px solid #b9e8cc;
    }

    .form-alert.failure {
      color: #982c35;
      background: #fff0f0;
      border: 1px solid #f3c4c7;
    }

    /* ===============================
       FORM FIELDS
    =============================== */

    .form-group {
      width: 100%;
      min-width: 0;
      margin-bottom: 22px;
    }

    .form-group label {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 9px;
      color: #25465c;
      font-size: 0.92rem;
      font-weight: 700;
      overflow-wrap: anywhere;
    }

    .form-group label i {
      width: 18px;
      color: #2584a7;
      text-align: center;
      flex-shrink: 0;
    }

    .required-asterisk {
      color: #d44350;
      margin-left: -5px;
    }

    .form-control {
      display: block;
      width: 100%;
      max-width: 100%;
      min-width: 0;
      min-height: 50px;
      padding: 13px 15px;
      border: 1.5px solid #dce6ee;
      border-radius: 13px;
      background: #fbfdff;
      color: #18374c;
      font-size: 16px;
      line-height: 1.5;
      outline: none;
      transition: border-color 0.2s, box-shadow 0.2s,
        background 0.2s;
    }

    .form-control::placeholder {
      color: #8493a0;
      opacity: 1;
    }

    .form-control:focus {
      border-color: #2383a6;
      background: #ffffff;
      box-shadow: 0 0 0 4px rgba(35, 131, 166, 0.11);
    }

    select.form-control {
      cursor: pointer;
      padding-right: 38px;
    }

    textarea.form-control {
      min-height: 135px;
      resize: vertical;
    }

    /* Error border is applied to the INPUT, not the whole group. */
    .form-group.error-border .form-control {
      border-color: #d64550 !important;
      background: #fff8f8;
      box-shadow: 0 0 0 3px rgba(214, 69, 80, 0.08);
    }

    .error-text {
      display: none;
      align-items: flex-start;
      gap: 7px;
      margin-top: 7px;
      color: #c53240;
      font-size: 0.82rem;
      line-height: 1.5;
      overflow-wrap: anywhere;
    }

    .error-text.show {
      display: flex;
    }

    .error-text i {
      margin-top: 4px;
      flex-shrink: 0;
    }

    .hint {
      display: block;
      margin: 7px 0 0 2px;
      color: #697f8e;
      font-size: 0.78rem;
    }

    /* ===============================
       SUBMIT BUTTON
    =============================== */

    .btn-submit {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 11px;
      width: 100%;
      min-height: 54px;
      padding: 14px 18px;
      border: none;
      border-radius: 999px;
      background: linear-gradient(105deg, #147391, #154f70);
      color: #ffffff;
      font-size: 1rem;
      font-weight: 800;
      cursor: pointer;
      box-shadow: 0 8px 18px rgba(17, 105, 140, 0.22);
      transition: transform 0.2s, box-shadow 0.2s,
        opacity 0.2s;
    }

    .btn-submit:hover {
      transform: translateY(-2px);
      box-shadow: 0 12px 22px rgba(17, 105, 140, 0.27);
    }

    .btn-submit:focus-visible {
      outline: 3px solid rgba(35, 131, 166, 0.35);
      outline-offset: 4px;
    }

    .btn-submit:disabled {
      opacity: 0.7;
      cursor: wait;
      transform: none;
    }

    .footer-note {
      margin-top: 18px;
      text-align: center;
      color: #61788a;
      font-size: 0.79rem;
      overflow-wrap: anywhere;
    }

    .footer-note i {
      color: #c13d4a;
      margin-right: 5px;
    }

    /* ===============================
       TABLET
    =============================== */

    @media (max-width: 768px) {
      .enquiry-page {
        padding: 28px 18px 45px;
      }

      .enquiry-wrapper {
        max-width: 600px;
      }

      .enquiry-card {
        padding: 28px 24px;
        border-radius: 24px;
      }

      .form-group {
        margin-bottom: 20px;
      }
    }

    /* ===============================
       MOBILE
    =============================== */

    @media (max-width: 550px) {
      html {
        scroll-padding-top: 110px;
      }

      .enquiry-page {
        min-height: 0;
        padding: 20px 12px 36px;
      }

      .enquiry-wrapper {
        width: 100%;
        max-width: 100%;
        margin: 0 auto;
      }

      .enquiry-card {
        padding: 23px 17px;
        border-radius: 20px;
        box-shadow: 0 12px 32px rgba(22, 57, 80, 0.09);
      }

      .card-header {
        gap: 11px;
      }

      .header-icon {
        flex-basis: 43px;
        width: 43px;
        height: 43px;
        border-radius: 12px;
        font-size: 19px;
      }

      .card-header h1 {
        font-size: clamp(1.35rem, 5.2vw, 1.65rem);
      }

      .subhead {
        margin: 13px 0 24px;
        padding: 9px 11px;
        font-size: 0.86rem;
      }

      .form-group {
        margin-bottom: 19px;
      }

      .form-group label {
        font-size: 0.88rem;
      }

      .form-control {
        min-height: 48px;
        padding: 12px;
        border-radius: 12px;
      }

      textarea.form-control {
        min-height: 120px;
      }

      .btn-submit {
        min-height: 51px;
        padding: 13px;
        font-size: 0.96rem;
      }

      .footer-note {
        font-size: 0.76rem;
      }
    }

    /* ===============================
       EXTRA SMALL PHONES
    =============================== */

    @media (max-width: 360px) {
      .enquiry-page {
        padding: 14px 8px 28px;
      }

      .enquiry-card {
        padding: 19px 13px;
        border-radius: 17px;
      }

      .header-icon {
        flex-basis: 38px;
        width: 38px;
        height: 38px;
        font-size: 17px;
      }

      .card-header h1 {
        font-size: 1.3rem;
      }

      .subhead {
        font-size: 0.82rem;
      }

      .form-control {
        padding: 11px 10px;
      }
    }

    /* Accessibility */
    @media (prefers-reduced-motion: reduce) {
      html {
        scroll-behavior: auto;
      }

      *,
      *::before,
      *::after {
        transition-duration: 0.01ms !important;
        animation-duration: 0.01ms !important;
      }
    }
    
/* ===== Admission Enquiry: Final Responsive Layout ===== */

html {
    width: 100%;
    min-height: 100%;
    scroll-behavior: smooth;
}

*,
*::before,
*::after {
    box-sizing: border-box;
}

body {
    width: 100%;
    min-width: 0;
    min-height: 100vh;
    margin: 0;
    overflow-x: clip;
    display: flex;
    flex-direction: column;
    background: #f3f7fc;
}

/* Main content area */
.enquiry-page {
    width: 100%;
    flex: 1 0 auto;
    padding: 32px 20px 48px;
}

/* Form container */
.enquiry-wrapper {
    width: 100%;
    max-width: 700px;
    margin: 0 auto;
    min-width: 0;
}

/* Form card */
.enquiry-card {
    width: 100%;
    min-width: 0;
    padding: 32px;
    background: #fff;
    border: 1px solid #e7edf4;
    border-radius: 24px;
    box-shadow: 0 14px 38px rgba(18, 55, 82, 0.09);
    overflow-wrap: anywhere;
}

/* Heading */
.card-header {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 10px;
}

.card-header i {
    flex-shrink: 0;
    font-size: 2rem;
}

.card-header h2 {
    min-width: 0;
    margin: 0;
    font-size: clamp(1.5rem, 3vw, 2rem);
    line-height: 1.3;
    overflow-wrap: anywhere;
}

/* Description */
.subhead {
    margin: 0 0 24px;
    padding: 10px 12px;
    line-height: 1.7;
    border-left: 4px solid #2a7faa;
    border-radius: 0 8px 8px 0;
    background: #f3f8fc;
    overflow-wrap: anywhere;
}

/* Form fields */
.form-group {
    width: 100%;
    min-width: 0;
    margin-bottom: 20px;
}

.form-group label {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 8px;
    font-size: 0.95rem;
    line-height: 1.5;
}

.form-group label i {
    flex-shrink: 0;
}

.form-control {
    display: block;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    min-height: 48px;
    padding: 12px 14px;
    border: 1px solid #d8e3ee;
    border-radius: 12px;
    background: #fbfdff;
    font-family: inherit;
    font-size: 16px;
    line-height: 1.5;
}

.form-control:focus {
    outline: none;
    border-color: #1f7ea3;
    background: #fff;
    box-shadow: 0 0 0 3px rgba(31, 126, 163, 0.12);
}

select.form-control {
    padding-right: 36px;
}

textarea.form-control {
    min-height: 130px;
    resize: vertical;
}

small.hint {
    display: block;
    margin-top: 6px;
    color: #5a6e7c;
    font-size: 0.78rem;
    line-height: 1.5;
}

/* Validation messages */
.error-text {
    display: none;
    align-items: flex-start;
    gap: 6px;
    margin-top: 7px;
    color: #c83e4d;
    font-size: 0.82rem;
    line-height: 1.5;
    overflow-wrap: anywhere;
}

.error-text i {
    flex-shrink: 0;
    margin-top: 3px;
}

.error-border .form-control {
    border-color: #c83e4d !important;
    background: #fff8f7;
}

/* Submit button */
.btn-submit {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    min-height: 50px;
    padding: 13px 18px;
    border: 0;
    border-radius: 28px;
    background: linear-gradient(105deg, #11698c, #144e70);
    color: #fff;
    font-family: inherit;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 7px 16px rgba(17, 105, 140, 0.2);
    transition: background 0.2s ease, transform 0.2s ease;
}

.btn-submit:hover {
    background: linear-gradient(105deg, #0f5e7a, #0e405a);
    transform: translateY(-1px);
}

.btn-submit:disabled {
    opacity: 0.65;
    cursor: wait;
    transform: none;
}

.footer-note {
    margin-top: 16px;
    text-align: center;
    color: #526a7c;
    font-size: 0.8rem;
    line-height: 1.7;
    overflow-wrap: anywhere;
}

.success-alert {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 20px;
    padding: 16px;
    border-left: 5px solid #1b8c5e;
    border-radius: 12px;
    background: #e1f3e8;
    color: #0b4635;
    overflow-wrap: anywhere;
}

.success-alert i {
    flex-shrink: 0;
    font-size: 1.4rem;
}

/* Tablet */
@media (max-width: 768px) {
    .enquiry-page {
        padding: 26px 16px 36px;
    }

    .enquiry-wrapper {
        max-width: 620px;
    }

    .enquiry-card {
        padding: 28px 24px;
        border-radius: 22px;
    }
}

/* Mobile */
@media (max-width: 550px) {
    .enquiry-page {
        padding: 18px 12px 28px;
    }

    .enquiry-wrapper {
        width: 100%;
        max-width: 100%;
        margin: 0 auto;
    }

    .enquiry-card {
        padding: 22px 16px;
        border-radius: 18px;
    }

    .card-header {
        align-items: flex-start;
        gap: 10px;
    }

    .card-header i {
        font-size: 1.65rem;
        margin-top: 2px;
    }

    .card-header h2 {
        font-size: 1.45rem;
    }

    .subhead {
        margin-bottom: 22px;
        font-size: 0.9rem;
    }

    .form-group {
        margin-bottom: 18px;
    }

    .form-group label {
        font-size: 0.9rem;
    }

    .form-control {
        min-height: 46px;
        padding: 12px;
        border-radius: 10px;
    }

    textarea.form-control {
        min-height: 120px;
    }

    .btn-submit {
        min-height: 48px;
        border-radius: 12px;
    }
}

/* Very small phones */
@media (max-width: 360px) {
    .enquiry-page {
        padding: 12px 8px 24px;
    }

    .enquiry-card {
        padding: 18px 12px;
    }

    .card-header h2 {
        font-size: 1.3rem;
    }

    .subhead {
        font-size: 0.85rem;
    }
}

/* Accessibility */
@media (prefers-reduced-motion: reduce) {
    html {
        scroll-behavior: auto;
    }

    *,
    *::before,
    *::after {
        transition-duration: 0.01ms !important;
        animation-duration: 0.01ms !important;
    }
}

  </style>
</head>

<body>

  <!-- Existing EJS navbar -->
  <%- include('partials/Navbar') %>

  <main class="enquiry-page">
    <div class="enquiry-wrapper">
      <section class="enquiry-card" aria-labelledby="enquiryTitle">

        <header class="card-header">
          <div class="header-icon" aria-hidden="true">
            <i class="fas fa-graduation-cap"></i>
          </div>

          <h1 id="enquiryTitle">Admission Enquiry</h1>
        </header>

        <p class="subhead">
          <i class="fas fa-phone-alt" aria-hidden="true"></i>
          Get answers — fill the form, we'll reach out within 24h.
        </p>

        <div
          id="liveSuccessMessage"
          class="form-alert"
          role="status"
          aria-live="polite"
        ></div>

        <form id="admissionEnquiryForm" novalidate>

          <!-- FULL NAME -->
          <div class="form-group" id="group-fullname">
            <label for="fullName">
              <i class="fas fa-user-graduate" aria-hidden="true"></i>
              Full name
              <span class="required-asterisk">*</span>
            </label>

            <input
              type="text"
              class="form-control"
              id="fullName"
              name="fullName"
              placeholder="e.g. Priya Sharma"
              autocomplete="name"
              maxlength="100"
              aria-describedby="errorFullName"
              required
            >

            <span class="error-text" id="errorFullName">
              <i class="fas fa-exclamation-circle" aria-hidden="true"></i>
              Please enter your full name (at least 2 characters).
            </span>
          </div>

          <!-- EMAIL -->
          <div class="form-group" id="group-email">
            <label for="email">
              <i class="fas fa-envelope" aria-hidden="true"></i>
              Email address
              <span class="required-asterisk">*</span>
            </label>

            <input
              type="email"
              class="form-control"
              id="email"
              name="email"
              placeholder="student@example.com"
              autocomplete="email"
              maxlength="254"
              aria-describedby="errorEmail"
              required
            >

            <span class="error-text" id="errorEmail">
              <i class="fas fa-exclamation-circle" aria-hidden="true"></i>
              Please enter a valid email address.
            </span>
          </div>

          <!-- PHONE -->
          <div class="form-group" id="group-phone">
            <label for="phone">
              <i class="fas fa-mobile-alt" aria-hidden="true"></i>
              Mobile number
              <span class="required-asterisk">*</span>
            </label>

            <input
              type="tel"
              class="form-control"
              id="phone"
              name="phone"
              placeholder="10-digit mobile number"
              inputmode="numeric"
              autocomplete="tel-national"
              maxlength="10"
              pattern="[0-9]{10}"
              aria-describedby="errorPhone phoneHint"
              required
            >

            <span class="error-text" id="errorPhone">
              <i class="fas fa-exclamation-circle" aria-hidden="true"></i>
              Enter exactly 10 digits.
            </span>

            <small class="hint" id="phoneHint">
              <i class="fas fa-info-circle" aria-hidden="true"></i>
              Enter your 10-digit mobile number.
            </small>
          </div>

          <!-- COURSE -->
          <div class="form-group" id="group-course">
            <label for="course">
              <i class="fas fa-book-open" aria-hidden="true"></i>
              Intended course
              <span class="required-asterisk">*</span>
            </label>

            <select
              class="form-control"
              id="course"
              name="course"
              aria-describedby="errorCourse"
              required
            >
              <option value="">-- Select your preferred program --</option>
              <option value="Bachelor of Arts">BA</option>
              <option value="Bachelor of Pharmacy">B.Pharm</option>
              <option value="Diploma in Pharmacy">D.Pharm</option>
              <option value="Auxiliary Nurse Midwifery">ANM</option>
              <option value="General Nursing and Midwifery">GNM</option>
              <option value="Diploma in Elementary Education">D.El.Ed</option>
              <option value="Other">Other / Not sure</option>
            </select>

            <span class="error-text" id="errorCourse">
              <i class="fas fa-exclamation-circle" aria-hidden="true"></i>
              Please select a course.
            </span>
          </div>

          <!-- ENQUIRY MESSAGE -->
          <div class="form-group" id="group-message">
            <label for="message">
              <i class="fas fa-comment-dots" aria-hidden="true"></i>
              Your enquiry
              <span class="required-asterisk">*</span>
            </label>

            <textarea
              class="form-control"
              id="message"
              name="message"
              placeholder="Ask about admission process, deadlines, scholarships, hostel..."
              maxlength="3000"
              rows="5"
              aria-describedby="errorMessage"
              required
            ></textarea>

            <span class="error-text" id="errorMessage">
              <i class="fas fa-exclamation-circle" aria-hidden="true"></i>
              Please write your question or enquiry.
            </span>
          </div>

          <!-- SUBMIT -->
          <button type="submit" class="btn-submit" id="submitEnquiry">
            <i class="fas fa-paper-plane" aria-hidden="true"></i>
            <span>Send enquiry</span>
          </button>

          <p class="footer-note">
            <i class="fas fa-shield-alt" aria-hidden="true"></i>
            Your enquiry will be sent securely to the college.
          </p>

        </form>
      </section>
    </div>
  </main>

  <script>
    (() => {
      "use strict";

      const form = document.getElementById("admissionEnquiryForm");

      const fields = {
        fullName: document.getElementById("fullName"),
        email: document.getElementById("email"),
        phone: document.getElementById("phone"),
        course: document.getElementById("course"),
        message: document.getElementById("message")
      };

      const groups = {
        fullName: document.getElementById("group-fullname"),
        email: document.getElementById("group-email"),
        phone: document.getElementById("group-phone"),
        course: document.getElementById("group-course"),
        message: document.getElementById("group-message")
      };

      const errors = {
        fullName: document.getElementById("errorFullName"),
        email: document.getElementById("errorEmail"),
        phone: document.getElementById("errorPhone"),
        course: document.getElementById("errorCourse"),
        message: document.getElementById("errorMessage")
      };

      const successDiv = document.getElementById("liveSuccessMessage");
      const submitButton = document.getElementById("submitEnquiry");
      const submitText = submitButton.querySelector("span");

      let isSubmitting = false;
      let messageTimer;

      // Show field error.
      function showError(key) {
        groups[key].classList.add("error-border");
        errors[key].classList.add("show");
        fields[key].setAttribute("aria-invalid", "true");
      }

      // Remove field error.
      function removeError(key) {
        groups[key].classList.remove("error-border");
        errors[key].classList.remove("show");
        fields[key].removeAttribute("aria-invalid");
      }

      // Reset every validation error.
      function resetErrors() {
        Object.keys(fields).forEach(removeError);
      }

      // Show a status message safely using textContent.
      function showAlert(type, messageText) {
        window.clearTimeout(messageTimer);

        successDiv.className = "form-alert show " + type;
        successDiv.replaceChildren();

        const icon = document.createElement("i");
        icon.className = type === "success"
          ? "fas fa-check-circle"
          : "fas fa-exclamation-circle";

        icon.setAttribute("aria-hidden", "true");

        const text = document.createElement("span");
        text.textContent = messageText;

        successDiv.append(icon, text);

        successDiv.scrollIntoView({
          behavior: "smooth",
          block: "center"
        });

        messageTimer = window.setTimeout(() => {
          successDiv.className = "form-alert";
          successDiv.replaceChildren();
        }, 8000);
      }

      // Validate all fields.
      function validateForm() {
        resetErrors();

        let isValid = true;

        const nameValue = fields.fullName.value.trim();
        const emailValue = fields.email.value.trim();
        const phoneValue = fields.phone.value.trim();
        const courseValue = fields.course.value;
        const messageValue = fields.message.value.trim();

        const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

        if (nameValue.length < 2) {
          showError("fullName");
          isValid = false;
        }

        if (!emailPattern.test(emailValue)) {
          showError("email");
          isValid = false;
        }

        if (!/^[0-9]{10}$/.test(phoneValue)) {
          showError("phone");
          isValid = false;
        }

        if (!courseValue) {
          showError("course");
          isValid = false;
        }

        if (messageValue.length < 3) {
          showError("message");
          isValid = false;
        }

        return isValid;
      }

      // Clear errors as the user corrects their entries.
      fields.fullName.addEventListener("input", () => {
        if (fields.fullName.value.trim().length >= 2) {
          removeError("fullName");
        }
      });

      fields.email.addEventListener("input", () => {
        const pattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

        if (pattern.test(fields.email.value.trim())) {
          removeError("email");
        }
      });

      fields.phone.addEventListener("input", () => {
        fields.phone.value = fields.phone.value
          .replace(/\D/g, "")
          .slice(0, 10);

        if (/^[0-9]{10}$/.test(fields.phone.value)) {
          removeError("phone");
        }
      });

      fields.course.addEventListener("change", () => {
        if (fields.course.value) {
          removeError("course");
        }
      });

      fields.message.addEventListener("input", () => {
        if (fields.message.value.trim().length >= 3) {
          removeError("message");
        }
      });

      // Handle pasted mobile numbers.
      fields.phone.addEventListener("paste", (event) => {
        event.preventDefault();

        const clipboard = event.clipboardData;

        if (!clipboard) return;

        fields.phone.value = clipboard
          .getData("text")
          .replace(/\D/g, "")
          .slice(0, 10);

        fields.phone.dispatchEvent(new Event("input", {
          bubbles: true
        }));
      });

      // Submit enquiry to the existing backend endpoint.
      form.addEventListener("submit", async (event) => {
        event.preventDefault();

        if (isSubmitting) return;

        successDiv.className = "form-alert";
        successDiv.replaceChildren();

        if (!validateForm()) {
          const firstInvalid = form.querySelector(
            '.form-group.error-border .form-control'
          );

          if (firstInvalid) {
            firstInvalid.scrollIntoView({
              behavior: "smooth",
              block: "center"
            });

            firstInvalid.focus({ preventScroll: true });
          }

          return;
        }

        const enquiryData = {
          fullName: fields.fullName.value.trim(),
          email: fields.email.value.trim(),
          phone: fields.phone.value.trim(),
          course: fields.course.value,
          message: fields.message.value.trim()
        };

        isSubmitting = true;
        submitButton.disabled = true;
        submitText.textContent = "Sending enquiry...";

        const buttonIcon = submitButton.querySelector("i");
        buttonIcon.className = "fas fa-spinner fa-spin";

        try {
          const response = await fetch("/api/admission-enquiry", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              "Accept": "application/json"
            },
            body: JSON.stringify(enquiryData)
          });

          // Handle unexpected non-JSON server responses too.
          const responseText = await response.text();
          let result = {};

          try {
            result = responseText ? JSON.parse(responseText) : {};
          } catch {
            result = {};
          }

          if (!response.ok || result.success !== true) {
            throw new Error(
              result.message ||
              "Enquiry could not be submitted. Please try again."
            );
          }

          form.reset();
          resetErrors();

          showAlert(
            "success",
            result.message ||
            "Enquiry submitted successfully! Thank you for contacting the college."
          );

        } catch (error) {
          console.error("Admission enquiry error:", error);

          showAlert(
            "failure",
            error.message ||
            "Server se connection nahi ho raha. Please try again."
          );

        } finally {
          isSubmitting = false;
          submitButton.disabled = false;
          submitText.textContent = "Send enquiry";
          buttonIcon.className = "fas fa-paper-plane";
        }
      });
    })();
  </script>
<%- include('partials/Footer') %>
</body>
</html>
