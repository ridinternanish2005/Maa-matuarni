
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Our Courses - HRI Group of Institutions</title>

    <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <link rel="stylesheet" href="/css/allcourese.css">
</head>
<body>

    <%- include('partials/Navbar') %>

    <main class="courses-page">

        <section class="courses-hero">
            <span class="hero-tag">LEARN • GROW • SUCCEED</span>
            <h1>Explore Our Courses</h1>
            <p>
                Discover the right program to build your knowledge,
                develop your skills, and shape your future.
            </p>
        </section>

        <section class="courses-container">

            <div class="courses-heading">
                <div>
                    <span class="section-label">ACADEMIC PROGRAMS</span>
                    <h2>Our Courses</h2>
                    <p>Choose a course that matches your career goals.</p>
                </div>
            </div>

            <div class="course-search">
                <i class="fas fa-search"></i>
                <input
                    type="search"
                    id="course-search"
                    placeholder="Search your course..."
                    aria-label="Search courses">
            </div>

            <div class="course-filters">
                <button class="filter-btn active" data-filter="all">
                    All Courses
                </button>
                <button class="filter-btn" data-filter="pharmacy">
                    Pharmacy
                </button>
                <button class="filter-btn" data-filter="arts">
                    Arts
                </button>
                <button class="filter-btn" data-filter="nursing">
                    Nursing
                </button>
                <button class="filter-btn" data-filter="education">
                    Education
                </button>
            </div>

            <div class="courses-grid" id="courses-grid">

                <!-- D.Pharmacy -->
                <article class="course-card" data-category="pharmacy">
                    <div class="course-icon">
                        <i class="fas fa-pills"></i>
                    </div>
                    <span class="course-category">PHARMACY</span>
                    <h3>D.Pharmacy</h3>
                    <p>
                        Develop foundational knowledge of medicines,
                        pharmaceutical science, and pharmacy practice.
                    </p>
                    <div class="course-footer">
                        <span><i class="fas fa-graduation-cap"></i> Diploma Program</span>
                        <a href="/d.pharma" class="course-link">
                            Explore Course <i class="fas fa-arrow-right"></i>
                        </a>
                    </div>
                </article>

                <!-- B.Pharmacy -->
                <article class="course-card" data-category="pharmacy">
                    <div class="course-icon">
                        <i class="fas fa-flask"></i>
                    </div>
                    <span class="course-category">PHARMACY</span>
                    <h3>B.Pharmacy</h3>
                    <p>
                        Learn pharmaceutical sciences, drug formulation,
                        quality control, and healthcare practices.
                    </p>
                    <div class="course-footer">
                        <span><i class="fas fa-graduation-cap"></i> Degree Program</span>
                        <a href="/bpharma" class="course-link">
                            Explore Course <i class="fas fa-arrow-right"></i>
                        </a>
                    </div>
                </article>

                <!-- BA -->
                <article class="course-card" data-category="arts">
                    <div class="course-icon">
                        <i class="fas fa-book-open"></i>
                    </div>
                    <span class="course-category">ARTS</span>
                    <h3>BA</h3>
                    <p>
                        Explore humanities, social sciences, and related
                        subjects to develop analytical and communication skills.
                    </p>
                    <div class="course-footer">
                        <span><i class="fas fa-graduation-cap"></i> Degree Program</span>
                        <a href="/BA" class="course-link">
                            Explore Course <i class="fas fa-arrow-right"></i>
                        </a>
                    </div>
                </article>

                <!-- ANM -->
                <article class="course-card" data-category="nursing">
                    <div class="course-icon">
                        <i class="fas fa-user-nurse"></i>
                    </div>
                    <span class="course-category">NURSING</span>
                    <h3>ANM</h3>
                    <p>
                        Learn the fundamentals of nursing, maternal care,
                        community health, and patient support.
                    </p>
                    <div class="course-footer">
                        <span><i class="fas fa-graduation-cap"></i> Nursing Program</span>
                        <a href="/anm" class="course-link">
                            Explore Course <i class="fas fa-arrow-right"></i>
                        </a>
                    </div>
                </article>

                <!-- JNAM -->
                <article class="course-card" data-category="nursing">
                    <div class="course-icon">
                        <i class="fas fa-heartbeat"></i>
                    </div>
                    <span class="course-category">NURSING</span>
                    <h3>JNAM</h3>
                    <p>
                        Explore the JNAM program and develop healthcare
                        knowledge relevant to your chosen career.
                    </p>
                    <div class="course-footer">
                        <span><i class="fas fa-graduation-cap"></i> Academic Program</span>
                        <a href="/jnam" class="course-link">
                            Explore Course <i class="fas fa-arrow-right"></i>
                        </a>
                    </div>
                </article>

                <!-- B.Ed -->
                <article class="course-card" data-category="education">
                    <div class="course-icon">
                        <i class="fas fa-chalkboard-teacher"></i>
                    </div>
                    <span class="course-category">EDUCATION</span>
                    <h3>B.Ed</h3>
                    <p>
                        Develop teaching skills, classroom management
                        techniques, and educational knowledge.
                    </p>
                    <div class="course-footer">
                        <span><i class="fas fa-graduation-cap"></i> Teacher Education</span>
                        <a href="/B.Ed" class="course-link">
                            Explore Course <i class="fas fa-arrow-right"></i>
                        </a>
                    </div>
                </article>

                <!-- B.El.Ed -->
                <article class="course-card" data-category="education">
                    <div class="course-icon">
                        <i class="fas fa-child"></i>
                    </div>
                    <span class="course-category">EDUCATION</span>
                    <h3>B.El.Ed</h3>
                    <p>
                        Study elementary education, child development,
                        teaching methods, and classroom learning.
                    </p>
                    <div class="course-footer">
                        <span><i class="fas fa-graduation-cap"></i> Teacher Education</span>
                        <a href="/B.El.Ed" class="course-link">
                            Explore Course <i class="fas fa-arrow-right"></i>
                        </a>
                    </div>
                </article>

                <!-- D.El.Ed -->
                <article class="course-card" data-category="education">
                    <div class="course-icon">
                        <i class="fas fa-school"></i>
                    </div>
                    <span class="course-category">EDUCATION</span>
                    <h3>D.El.Ed</h3>
                    <p>
                        Build foundational teaching knowledge and practical
                        skills for elementary-level education.
                    </p>
                    <div class="course-footer">
                        <span><i class="fas fa-graduation-cap"></i> Diploma Program</span>
                        <a href="/d.el.ed" class="course-link">
                            Explore Course <i class="fas fa-arrow-right"></i>
                        </a>
                    </div>
                </article>

            </div>

            <div class="no-results" id="no-results" hidden>
                <i class="fas fa-search"></i>
                <h3>No courses found</h3>
                <p>Try searching with another course name.</p>
            </div>

        </section>
    </main>

    <%- include('partials/Footer.ejs') %>

    <script>
        const searchInput = document.getElementById('course-search');
        const filterButtons = document.querySelectorAll('.filter-btn');
        const courseCards = document.querySelectorAll('.course-card');
        const noResults = document.getElementById('no-results');

        let activeFilter = 'all';

        function filterCourses() {
            const searchText = searchInput.value.toLowerCase().trim();
            let visibleCount = 0;

            courseCards.forEach(card => {
                const category = card.dataset.category;
                const text = card.textContent.toLowerCase();

                const matchesCategory =
                    activeFilter === 'all' || category === activeFilter;

                const matchesSearch = text.includes(searchText);
                const isVisible = matchesCategory && matchesSearch;

                card.hidden = !isVisible;

                if (isVisible) visibleCount++;
            });

            noResults.hidden = visibleCount !== 0;
        }

        searchInput.addEventListener('input', filterCourses);

        filterButtons.forEach(button => {
            button.addEventListener('click', () => {
                filterButtons.forEach(btn => btn.classList.remove('active'));

                button.classList.add('active');
                activeFilter = button.dataset.filter;

                filterCourses();
            });
        });
    </script>

</body>
</html>
