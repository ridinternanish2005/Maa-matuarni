<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>Program-wise Admission | Maa Matuarni</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    :root {
      --primary: #8b2c1d;
      --primary-dark: #692015;
      --accent: #e67e22;
      --page: #fefaf5;
      --soft: #fef3ea;
      --text: #2c2823;
      --muted: #6b625b;
      --border: #f0dfd2;
      --white: #fff;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body { font-family: Inter, Arial, sans-serif; background: var(--page); color: var(--text); line-height: 1.6; }
    button, input, select, textarea { font: inherit; }
    button, a { -webkit-tap-highlight-color: transparent; }
    .container { width: min(1280px, 100%); margin: 0 auto; padding: 0 24px; }
    .hero { background: linear-gradient(125deg, var(--primary-dark), #b24332); color: #fff; padding: 52px 0 58px; position: relative; overflow: hidden; }
    .hero::after { content: "📖"; position: absolute; right: 4%; bottom: -40px; font-size: clamp(100px, 17vw, 200px); opacity: .07; pointer-events: none; }
    .hero-content { position: relative; z-index: 1; }
    .badge-program { display: inline-block; padding: 6px 14px; border-radius: 40px; background: rgba(255,245,225,.18); border: 1px solid rgba(255,255,255,.25); font-size: .8rem; font-weight: 600; margin-bottom: 14px; }
    .hero h1 { font: 700 clamp(1.8rem, 4vw, 2.7rem)/1.2 Poppins, sans-serif; letter-spacing: -.4px; }
    .hero .tagline { margin-top: 14px; border-left: 4px solid #f9b572; padding-left: 14px; max-width: 700px; color: #fff5ef; }
    .section-title { font: 700 clamp(1.45rem, 3vw, 1.9rem)/1.3 Poppins, sans-serif; color: var(--primary); margin: 38px 0 25px; }
    .section-title i { color: var(--accent); margin-right: 8px; }
    .course-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; margin-bottom: 34px; align-items: stretch; }
    .course-card { background: var(--white); border-radius: 22px; box-shadow: 0 12px 24px -12px rgba(0,0,0,.12); overflow: hidden; border: 1px solid var(--border); display: flex; flex-direction: column; min-width: 0; transition: transform .2s ease, box-shadow .2s ease; }
    .course-card:hover { transform: translateY(-4px); box-shadow: 0 18px 30px -12px rgba(139,44,29,.18); border-color: #e9c3ad; }
    .card-header { background: var(--soft); padding: 21px 22px; border-bottom: 1px solid var(--border); }
    .card-header h2 { font: 700 clamp(1.15rem, 2vw, 1.45rem)/1.35 Poppins, sans-serif; color: #9b3b2a; display: flex; align-items: center; gap: 11px; overflow-wrap: anywhere; }
    .card-header h2 i { color: var(--accent); flex: 0 0 auto; }
    .duration { display: inline-block; background: #fff0e4; padding: 5px 12px; border-radius: 50px; font-size: .78rem; font-weight: 600; color: #9b4c31; margin-top: 11px; }
    .card-body { padding: 22px; display: flex; flex-direction: column; flex: 1; }
    .info-block { margin-bottom: 18px; }
    .info-label { font-weight: 700; color: #5c3e2e; display: flex; align-items: center; gap: 8px; margin-bottom: 6px; font-size: .92rem; }
    .info-label i { color: var(--accent); width: 20px; text-align: center; flex: 0 0 auto; }
    .info-text { color: #51443b; padding-left: 28px; font-size: .88rem; line-height: 1.6; overflow-wrap: anywhere; }
    .fee-range { background: #fef7e8; border-radius: 13px; padding: 11px 13px; margin: 0 0 16px; font-weight: 500; font-size: .85rem; text-align: center; }
    .card-actions { margin-top: auto; }
    .btn-outline, .apply-course { background: transparent; border: 1.5px solid #c26446; color: #9b2c1d; padding: 11px 18px; border-radius: 40px; font-weight: 700; font-size: .88rem; cursor: pointer; transition: all .2s; display: inline-flex; align-items: center; justify-content: center; gap: 8px; text-decoration: none; min-height: 44px; }
    .apply-course { width: 100%; }
    .btn-outline:hover, .apply-course:hover { background: var(--primary); color: white; border-color: var(--primary); }
    .steps-common { background: #fff9f2; border-radius: 24px; padding: clamp(20px, 4vw, 32px); margin: 35px 0; border: 1px solid #f7e7db; }
    .steps-common h3 { font: 700 1.35rem/1.4 Poppins, sans-serif; color: var(--primary); margin-bottom: 8px; }
    .steps-flex { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; margin-top: 22px; }
    .step-item { text-align: center; background: white; border-radius: 18px; padding: 20px 14px; box-shadow: 0 4px 8px rgba(0,0,0,.03); font-size: .9rem; }
    .step-num { background: #f1d9ce; width: 40px; height: 40px; display: inline-flex; align-items: center; justify-content: center; border-radius: 50%; font-weight: 800; color: #a23f2c; margin-bottom: 10px; }
    .helpdesk { background: #fdf2e8; border-radius: 24px; padding: 28px; margin: 30px 0 42px; text-align: center; }
    .helpdesk h3 { color: var(--primary); font: 700 1.3rem/1.4 Poppins, sans-serif; margin-bottom: 10px; }
    .helpdesk p { overflow-wrap: anywhere; }
    .helpdesk .btn-outline { margin-top: 16px; background: var(--primary); color: white; }
    footer { background: #2d241e; color: #e2cfbc; padding: 28px 16px; margin-top: 42px; text-align: center; }
    [hidden] { display: none !important; }

    /* Apply form modal */
    .modal-backdrop { position: fixed; inset: 0; z-index: 9999; background: rgba(24,18,15,.65); display: none; align-items: center; justify-content: center; padding: 16px; overflow-y: auto; }
    .modal-backdrop.open { display: flex; }
    .apply-modal { width: min(520px, 100%); background: white; border-radius: 20px; overflow: hidden; box-shadow: 0 25px 70px rgba(0,0,0,.25); max-height: calc(100dvh - 32px); overflow-y: auto; }
    .modal-head { background: linear-gradient(125deg, var(--primary-dark), #b24332); color: white; padding: 20px 22px; display: flex; justify-content: space-between; align-items: center; gap: 12px; }
    .modal-head h2 { font: 700 1.2rem Poppins, sans-serif; }
    .close-modal { background: transparent; border: 0; color: white; font-size: 1.6rem; cursor: pointer; line-height: 1; padding: 4px 8px; }
    .apply-form { padding: 22px; display: grid; gap: 14px; }
    .form-field label { display: block; font-size: .88rem; font-weight: 700; margin-bottom: 6px; color: #4b352c; }
    .form-field input, .form-field select, .form-field textarea { width: 100%; min-height: 44px; border: 1px solid #dfd4cc; border-radius: 10px; padding: 10px 12px; outline: none; background: #fffdfa; color: var(--text); }
    .form-field input:focus, .form-field select:focus, .form-field textarea:focus { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(230,126,34,.12); }
    .form-note { font-size: .8rem; color: var(--muted); }
    .submit-application { border: 0; background: var(--primary); color: white; padding: 13px 18px; border-radius: 10px; cursor: pointer; font-weight: 700; }
    .submit-application:hover { background: var(--primary-dark); }
    .form-status { font-size: .9rem; font-weight: 600; color: #236b3b; overflow-wrap: anywhere; }

    @media (max-width: 1000px) {
      .course-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
      .steps-flex { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }
    @media (max-width: 600px) {
      .container { padding: 0 15px; }
      .hero { padding: 38px 0 44px; }
      .hero .tagline { font-size: .92rem; }
      .section-title { margin: 28px 0 20px; }
      .course-grid { grid-template-columns: minmax(0, 1fr); gap: 16px; }
      .card-header { padding: 19px; }
      .card-body { padding: 19px; }
      .steps-flex { grid-template-columns: minmax(0, 1fr); }
      .steps-common, .helpdesk { border-radius: 18px; }
      .helpdesk { padding: 22px 16px; }
      .modal-backdrop { align-items: flex-end; padding: 0; }
      .apply-modal { width: 100%; border-radius: 20px 20px 0 0; max-height: 92dvh; }
      .apply-form { padding: 18px; }
    }
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { scroll-behavior: auto !important; transition: none !important; }
    }
  </style>
</head>
<body>
  <%- include('partials/Navbar') %>

  <header class="hero">
    <div class="container hero-content">
      <span class="badge-program">ADMISSIONS • ACADEMIC PROGRAMS</span>
      <h1>Program-wise Admission</h1>
      <p class="tagline">Explore our academic programs and start planning your future with Maa Matuarni.</p>
    </div>
  </header>

  <main class="container">
    <h2 class="section-title"><i class="fas fa-graduation-cap"></i> पाठ्यक्रम अनुसार प्रवेश विवरण</h2>

    <section class="course-grid" aria-label="Available courses">
      <article class="course-card">
        <div class="card-header"><h2><i class="fas fa-capsules"></i> D.Pharmacy</h2><span class="duration"><i class="far fa-clock"></i> Duration: 2 Years</span></div>
        <div class="card-body">
          <div class="info-block"><div class="info-label"><i class="fas fa-user-graduate"></i> Eligibility</div><p class="info-text">10+2 with Physics, Chemistry and Biology/Mathematics. Confirm current minimum marks and eligibility with the college.</p></div>
          <div class="info-block"><div class="info-label"><i class="fas fa-file-signature"></i> Admission</div><p class="info-text">Admission and seat availability are subject to current institute and applicable regulatory rules.</p></div>
          <div class="fee-range"><i class="fas fa-info-circle"></i> Contact the admission office for the current fee.</div>
          <div class="card-actions"><button type="button" class="apply-course" data-course="D.Pharmacy">Apply Now <i class="fas fa-arrow-right"></i></button></div>
        </div>
      </article>

      <article class="course-card">
        <div class="card-header"><h2><i class="fas fa-flask"></i> B.Pharmacy</h2><span class="duration"><i class="far fa-clock"></i> Duration: 4 Years</span></div>
        <div class="card-body">
          <div class="info-block"><div class="info-label"><i class="fas fa-user-graduate"></i> Eligibility</div><p class="info-text">10+2 with Physics, Chemistry and Biology/Mathematics. Confirm current eligibility and admission requirements with the college.</p></div>
          <div class="info-block"><div class="info-label"><i class="fas fa-clipboard-list"></i> Admission</div><p class="info-text">Admission is subject to applicable pharmacy regulations, eligibility and seat availability.</p></div>
          <div class="fee-range"><i class="fas fa-info-circle"></i> Contact the admission office for the current fee.</div>
          <div class="card-actions"><button type="button" class="apply-course" data-course="B.Pharmacy">Apply Now <i class="fas fa-arrow-right"></i></button></div>
        </div>
      </article>

      <article class="course-card">
        <div class="card-header"><h2><i class="fas fa-landmark"></i> Bachelor of Arts (BA)</h2><span class="duration"><i class="far fa-clock"></i> Duration: Confirm with college</span></div>
        <div class="card-body">
          <div class="info-block"><div class="info-label"><i class="fas fa-user-graduate"></i> Eligibility</div><p class="info-text">10+2 from a recognized board. Subject options and minimum marks should be confirmed with the college.</p></div>
          <div class="info-block"><div class="info-label"><i class="fas fa-book-open"></i> Program Details</div><p class="info-text">Ask the admission office about available subjects, course structure and current admission requirements.</p></div>
          <div class="fee-range"><i class="fas fa-info-circle"></i> Contact the admission office for the current fee.</div>
          <div class="card-actions"><button type="button" class="apply-course" data-course="BA">Apply Now <i class="fas fa-arrow-right"></i></button></div>
        </div>
      </article>

      <article class="course-card">
        <div class="card-header"><h2><i class="fas fa-hand-holding-heart"></i> ANM</h2><span class="duration"><i class="far fa-clock"></i> Duration: Confirm with college</span></div>
        <div class="card-body">
          <div class="info-block"><div class="info-label"><i class="fas fa-user-graduate"></i> Eligibility</div><p class="info-text">Eligibility, age criteria and medical fitness requirements must be confirmed against current nursing regulations.</p></div>
          <div class="info-block"><div class="info-label"><i class="fas fa-stethoscope"></i> Admission Process</div><p class="info-text">Ask the admission office about the current selection process and clinical training details.</p></div>
          <div class="fee-range"><i class="fas fa-info-circle"></i> Contact the admission office for the current fee.</div>
          <div class="card-actions"><button type="button" class="apply-course" data-course="ANM">Apply Now <i class="fas fa-arrow-right"></i></button></div>
        </div>
      </article>

      <article class="course-card">
        <div class="card-header"><h2><i class="fas fa-heartbeat"></i> GNM</h2><span class="duration"><i class="far fa-clock"></i> Duration: Confirm with college</span></div>
        <div class="card-body">
          <div class="info-block"><div class="info-label"><i class="fas fa-user-graduate"></i> Eligibility</div><p class="info-text">Current subject, marks and other eligibility criteria should be verified with the college and nursing authorities.</p></div>
          <div class="info-block"><div class="info-label"><i class="fas fa-clinic-medical"></i> Admission</div><p class="info-text">Ask the admission office about current selection criteria and clinical training arrangements.</p></div>
          <div class="fee-range"><i class="fas fa-info-circle"></i> Contact the admission office for the current fee.</div>
          <div class="card-actions"><button type="button" class="apply-course" data-course="GNM">Apply Now <i class="fas fa-arrow-right"></i></button></div>
        </div>
      </article>

      <article class="course-card">
        <div class="card-header"><h2><i class="fas fa-chalkboard-teacher"></i> B.Ed</h2><span class="duration"><i class="far fa-clock"></i> Duration: 2 Years (typically)</span></div>
        <div class="card-body">
          <div class="info-block"><div class="info-label"><i class="fas fa-user-graduate"></i> Eligibility</div><p class="info-text">Graduation or equivalent qualification, subject to current NCTE, university and state admission rules.</p></div>
          <div class="info-block"><div class="info-label"><i class="fas fa-university"></i> Admission Mode</div><p class="info-text">Confirm the applicable entrance examination, counselling process and seat availability with the college.</p></div>
          <div class="fee-range"><i class="fas fa-info-circle"></i> Contact the admission office for the current fee.</div>
          <div class="card-actions"><button type="button" class="apply-course" data-course="B.Ed">Apply Now <i class="fas fa-arrow-right"></i></button></div>
        </div>
      </article>

      <!-- Newly added B.El.Ed course card -->
      <article class="course-card">
        <div class="card-header"><h2><i class="fas fa-child"></i> B.El.Ed</h2><span class="duration"><i class="far fa-clock"></i> Duration: 4 Years (typically)</span></div>
        <div class="card-body">
          <div class="info-block"><div class="info-label"><i class="fas fa-user-graduate"></i> Eligibility</div><p class="info-text">Typically requires 10+2 or equivalent. Minimum marks, age and other requirements depend on current university and admission rules.</p></div>
          <div class="info-block"><div class="info-label"><i class="fas fa-book-reader"></i> Program Details</div><p class="info-text">An elementary teacher education program covering child development, teaching methods and school-based learning. Confirm availability with the college.</p></div>
          <div class="fee-range"><i class="fas fa-info-circle"></i> Contact the admission office for course availability and current fee.</div>
          <div class="card-actions"><button type="button" class="apply-course" data-course="B.El.Ed">Apply Now <i class="fas fa-arrow-right"></i></button></div>
        </div>
      </article>

      <article class="course-card">
        <div class="card-header"><h2><i class="fas fa-school"></i> D.El.Ed</h2><span class="duration"><i class="far fa-clock"></i> Duration: 2 Years (typically)</span></div>
        <div class="card-body">
          <div class="info-block"><div class="info-label"><i class="fas fa-user-graduate"></i> Eligibility</div><p class="info-text">10+2 or equivalent from a recognized board; current minimum marks and other conditions should be verified.</p></div>
          <div class="info-block"><div class="info-label"><i class="fas fa-edit"></i> Selection Procedure</div><p class="info-text">Confirm the current state or university admission procedure, merit rules and counselling schedule.</p></div>
          <div class="fee-range"><i class="fas fa-info-circle"></i> Contact the admission office for the current fee.</div>
          <div class="card-actions"><button type="button" class="apply-course" data-course="D.El.Ed">Apply Now <i class="fas fa-arrow-right"></i></button></div>
        </div>
      </article>
    </section>

    <section class="steps-common">
      <h3><i class="fas fa-tasks"></i> सामान्य प्रवेश प्रक्रिया</h3>
      <p>Admission steps and required documents may vary by course. Confirm the latest details with the admission office.</p>
      <div class="steps-flex">
        <div class="step-item"><span class="step-num">1</span><br><strong>Enquiry / Registration</strong><br>Choose your preferred course and submit your enquiry.</div>
        <div class="step-item"><span class="step-num">2</span><br><strong>Document Submission</strong><br>Keep marksheets, ID and required documents ready.</div>
        <div class="step-item"><span class="step-num">3</span><br><strong>Eligibility Check</strong><br>Confirm course-specific eligibility and selection rules.</div>
        <div class="step-item"><span class="step-num">4</span><br><strong>Admission Confirmation</strong><br>Follow the official instructions for counselling and fees.</div>
      </div>
    </section>

    <section class="helpdesk">
      <h3><i class="fas fa-headset"></i> Admission Enquiry</h3>
      <p>Submit the enquiry form using any course's <strong>Apply Now</strong> button. The form will prepare an email enquiry for the admission office.</p>
      <button type="button" class="btn-outline" id="generalEnquiryBtn"><i class="fas fa-envelope"></i> General Enquiry</button>
    </section>
  </main>

  <!-- Apply Now modal -->
  <div class="modal-backdrop" id="applyModal" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
    <div class="apply-modal">
      <div class="modal-head">
        <h2 id="modalTitle">Course Admission Enquiry</h2>
        <button type="button" class="close-modal" id="closeModal" aria-label="Close form">&times;</button>
      </div>
      <form class="apply-form" id="applyForm">
        <div class="form-field">
          <label for="applicantName">Full Name *</label>
          <input id="applicantName" name="name" type="text" autocomplete="name" required maxlength="100" placeholder="Enter your full name">
        </div>
        <div class="form-field">
          <label for="applicantPhone">Mobile Number *</label>
          <input id="applicantPhone" name="phone" type="tel" autocomplete="tel" inputmode="numeric" pattern="[0-9+() -]{10,18}" required placeholder="Enter your contact number">
        </div>
        <div class="form-field">
          <label for="applicantCourse">Select Course *</label>
          <select id="applicantCourse" name="course" required>
            <option value="">Choose a course</option>
            <option>D.Pharmacy</option>
            <option>B.Pharmacy</option>
            <option>BA</option>
            <option>ANM</option>
            <option>GNM</option>
            <option>B.Ed</option>
            <option>B.El.Ed</option>
            <option>D.El.Ed</option>
          </select>
        </div>
        <div class="form-field">
          <label for="applicantMessage">Message (optional)</label>
          <textarea id="applicantMessage" name="message" rows="3" maxlength="1000" placeholder="Ask about eligibility, fees or admission"></textarea>
        </div>
        <p class="form-note">Submitting opens your email application with the details filled in. Your email app must be configured to send it.</p>
        <button type="submit" class="submit-application"><i class="fas fa-paper-plane"></i> Prepare Enquiry Email</button>
        <p id="formStatus" class="form-status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </div>

  <%- include('partials/Footer.ejs') %>

  <script>
    (() => {
      const modal = document.getElementById('applyModal');
      const form = document.getElementById('applyForm');
      const courseSelect = document.getElementById('applicantCourse');
      const nameInput = document.getElementById('applicantName');
      const status = document.getElementById('formStatus');
      const closeButton = document.getElementById('closeModal');

      function openModal(course = '') {
        form.reset();
        status.textContent = '';
        courseSelect.value = course;
        modal.classList.add('open');
        document.body.style.overflow = 'hidden';
        window.setTimeout(() => (course ? nameInput : courseSelect).focus(), 50);
      }

      function closeModal() {
        modal.classList.remove('open');
        document.body.style.overflow = '';
      }

      document.querySelectorAll('.apply-course').forEach(button => {
        button.addEventListener('click', () => openModal(button.dataset.course || ''));
      });

      document.getElementById('generalEnquiryBtn').addEventListener('click', () => openModal(''));
      closeButton.addEventListener('click', closeModal);

      modal.addEventListener('click', event => {
        if (event.target === modal) closeModal();
      });

      document.addEventListener('keydown', event => {
        if (event.key === 'Escape' && modal.classList.contains('open')) closeModal();
      });

      form.addEventListener('submit', event => {
        event.preventDefault();
        if (!form.reportValidity()) return;

        const data = new FormData(form);
        const name = String(data.get('name') || '').trim();
        const phone = String(data.get('phone') || '').trim();
        const course = String(data.get('course') || '').trim();
        const message = String(data.get('message') || '').trim();

        const subject = `Admission Enquiry - ${course}`;
        const body = [
          'Maa Matuarni Admission Enquiry',
          '',
          `Applicant Name: ${name}`,
          `Mobile Number: ${phone}`,
          `Course: ${course}`,
          `Message: ${message || 'No additional message'}`
        ].join('\n');

        // This email address is taken from the supplied page. Confirm it is active before publishing.
        const email = 'admission@maamatuarni.edu.in';
        const mailto = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;

        status.textContent = 'Opening your email app with the enquiry details…';
        window.location.href = mailto;
      });
    })();
  </script>
</body>
</html>
