
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admission Application | Maa Matuarani College</title>

  <link rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

  <link rel="stylesheet" href="/css/admission.css">
</head>
<body>

  <%- include('partials/Navbar') %>

  <header class="admission-hero">
    <span class="hero-badge">
      <i class="fas fa-graduation-cap"></i> Admissions Open
    </span>
    <h1>Admission Application Form</h1>
    <p>Fill in your details to enquire about admission.</p>
  </header>

  <main class="admission-container">
    <section class="admission-card">

      <div class="card-heading">
        <i class="fas fa-file-signature"></i>
        <div>
          <h2>Applicant Details</h2>
          <p>Fields marked * are required.</p>
        </div>
      </div>

    
<% if (typeof successMessage !== "undefined" && successMessage) { %>
  <div class="success-message">
    <%= successMessage %>
  </div>
<% } %>
      <form id="admissionForm" action="/admission" method="POST">

        <div class="form-grid">

          <div class="form-group">
            <label for="fullName">Full Name *</label>
            <input type="text" id="fullName" name="fullName"
              placeholder="Enter your full name" maxlength="100" required>
          </div>

          <div class="form-group">
            <label for="fatherName">Father's Name *</label>
            <input type="text" id="fatherName" name="fatherName"
              placeholder="Enter father's name" maxlength="100" required>
          </div>

          <div class="form-group">
            <label for="mobile">Mobile Number *</label>
            <input type="tel" id="mobile" name="mobile"
              placeholder="10-digit mobile number"
              pattern="[0-9]{10}" maxlength="10"
              inputmode="numeric" required>
          </div>

          <div class="form-group">
            <label for="email">Email Address *</label>
            <input type="email" id="email" name="email"
              placeholder="example@gmail.com" required>
          </div>

          <div class="form-group">
            <label for="dob">Date of Birth *</label>
            <input type="date" id="dob" name="dob" required>
          </div>

          <div class="form-group">
            <label for="gender">Gender *</label>
            <select id="gender" name="gender" required>
              <option value="">Select Gender</option>
              <option value="Male">Male</option>
              <option value="Female">Female</option>
              <option value="Other">Other</option>
            </select>
          </div>

          <div class="form-group full-width">
            <label for="address">Complete Address *</label>
            <input type="text" id="address" name="address"
              placeholder="City, State and PIN code" required>
          </div>

          <div class="form-group">
            <label for="course">Course Interested In *</label>
            <select id="course" name="course" required>
              <option value="">Select Course</option>
              <option value="BA">BA</option>
              <option value="B.Pharm">B.Pharm</option>
              <option value="D.Pharm">D.Pharm</option>
              <option value="B.Ed">B.Ed</option>
              <option value="B.El.Ed">B.El.Ed</option>
              <option value="ANM">ANM</option>
              <option value="GNM">GNM</option>
              <option value="D.El.Ed">D.El.Ed</option>
              <option value="Other">Other / Not Sure</option>
            </select>
          </div>

          <div class="form-group">
            <label for="percentage">12th Percentage *</label>
            <input type="number" id="percentage" name="percentage"
              min="0" max="100" step="0.01"
              placeholder="e.g. 78.5" required>
          </div>

        </div>

        <button type="submit" class="submit-btn">
          Submit Admission Form
          <i class="fas fa-arrow-right"></i>
        </button>

      </form>
    </section>

    <div class="help-card">
      <i class="fas fa-headset"></i>
      <div>
        <h3>Need Help?</h3>
        <p>Please check your contact details before submitting the form.</p>
      </div>
    </div>
  </main>

  <%- include('partials/Footer.ejs') %>

  <script src="/js/admission.js" defer></script>
</body>
</html>
