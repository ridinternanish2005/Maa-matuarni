                <td><%= fee.enrollment || "—" %></td>
                <td><%= fee.course || "—" %></td>
                <td><%= fee.semester || "—" %></td>
                <td>₹<%= Number(fee.totalFees || 0).toLocaleString("en-IN") %></td>
                <td>₹<%= Number(fee.paidFees || 0).toLocaleString("en-IN") %></td>
                <td>₹<%= Number(fee.pendingFees || 0).toLocaleString("en-IN") %></td>
