<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Principal Dashboard | Maa Maturani ERP</title>
<link rel="stylesheet" href="/css/principle.css">
</head>
<body>

<div class="layout">

  <!-- SIDEBAR -->
  <aside class="sidebar" id="principalSidebar">

    <div class="brand">Maa Maturani ERP</div>
    <div class="subbrand">College Management System</div>

    <div class="user-info">
      <strong><%= principal.name || "Principal" %></strong><br>
      <%= principal.enrollment || "Principal Account" %><br>
      Session: <%= principal.session || "—" %>
    </div>

    <button type="button" class="nav-btn active"
            data-section="dashboard">🏠 Dashboard</button>

    <button type="button" class="nav-btn"
            data-section="students">🎓 Students</button>

    <button type="button" class="nav-btn"
            data-section="faculty">👨‍🏫 Faculty</button>

    <button type="button" class="nav-btn"
            data-section="courses">📚 Courses</button>

    <button type="button" class="nav-btn"
            data-section="attendance">📅 Attendance</button>

    <button type="button" class="nav-btn"
            data-section="fees">💰 Fees</button>

    <button type="button" class="nav-btn"
            data-section="notices">📢 Notices</button>

    <button type="button" class="nav-btn"
            data-section="reports">📊 Reports</button>

  </aside>

  <!-- MOBILE SIDEBAR OVERLAY -->
  <div class="sidebar-overlay" id="sidebarOverlay"></div>

  <!-- MAIN CONTENT -->
  <main class="main">

    <header class="topbar">

      <!-- LEFT SIDE: MENU + TITLE -->
      <div class="topbar-left">

        <button
          type="button"
          class="menu-toggle"
          id="menuToggle"
          aria-controls="principalSidebar"
          aria-expanded="false"
          aria-label="Toggle navigation"
        >
          <i class="fas fa-bars" aria-hidden="true"></i>
          <span>Menu</span>
        </button>

        <h2 id="pageTitle">🏠 Dashboard</h2>

      </div>

      <!-- RIGHT SIDE: SESSION + PRINCIPAL -->
      <div class="topbar-right">
        <span class="badge">
          Session: <%= principal.session || "—" %>
        </span>

        <strong>
          <%= principal.name || "Principal" %>
        </strong>
      </div>

    </header>

    <!-- YOUR EXISTING DASHBOARD SECTIONS CONTINUE BELOW -->
```
    <div class="content">

      <!-- DASHBOARD -->
      <section class="section active" id="dashboard">
        <div class="cards">
          <div class="stat-card blue">
            <div class="label">Total Active Students</div>
            <div class="number"><%= stats.students || 0 %></div>
          </div>

          <div class="stat-card green">
            <div class="label">Active Faculty</div>
            <div class="number"><%= stats.faculty || 0 %></div>
          </div>

          <div class="stat-card orange">
            <div class="label">Active Courses</div>
            <div class="number"><%= stats.courses || 0 %></div>
          </div>

          <div class="stat-card purple">
            <div class="label">Attendance Records</div>
            <div class="number"><%= stats.attendanceRecords || 0 %></div>
          </div>

          <div class="stat-card blue">
            <div class="label">Fee Records</div>
            <div class="number"><%= stats.feeRecords || 0 %></div>
          </div>

          <div class="stat-card green">
            <div class="label">Total Notices</div>
            <div class="number"><%= stats.notices || 0 %></div>
          </div>
        </div>

        <div class="panel">
          <h3>Recently Added Students</h3>
          <div class="table-wrap">
            <table>
              <thead>
                <tr><th>Name</th><th>Enrollment</th><th>Session</th></tr>
              </thead>
              <tbody>
                <% if (recentStudents && recentStudents.length) { %>
                  <% recentStudents.forEach(student => { %>
                    <tr>
                      <td><%= student.name || student.fullName || "—" %></td>
                      <td><%= student.enrollment || student.enrollmentNumber || "—" %></td>
                      <td><%= student.session || "—" %></td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr><td colspan="3" class="empty-cell">No student records found.</td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>

        <div class="panel">
          <h3>Latest Notices</h3>
          <% if (recentNotices && recentNotices.length) { %>
            <% recentNotices.forEach(notice => { %>
              <div class="notice-item">
                <strong><%= notice.title || notice.subject || "Notice" %></strong>
                <div class="muted">
                  <%= notice.message || notice.description || notice.content || "No description available." %>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <p class="muted">No notices available.</p>
          <% } %>
        </div>
      </section>

      <!-- STUDENTS -->
      <section class="section" id="students">
        <div class="panel">
          <h3>🎓 Student Management</h3>

          <form id="studentForm" class="student-form">
            <input type="hidden" id="studentId">

            <div class="form-grid">
              <div class="form-group">
                <label for="studentEnrollment">Enrollment Number *</label>
                <input class="form-control" id="studentEnrollment"
                       required maxlength="50" placeholder="e.g. STU001">
              </div>

              <div class="form-group">
                <label for="studentName">Student Name *</label>
                <input class="form-control" id="studentName"
                       required maxlength="100" placeholder="Enter student name">
              </div>

              <div class="form-group">
                <label for="studentMobile">Mobile Number *</label>
                <input class="form-control" id="studentMobile"
                       required maxlength="15" placeholder="Enter mobile number">
              </div>

              <div class="form-group">
                <label for="studentCourse">Course *</label>
                <input class="form-control" id="studentCourse"
                       required maxlength="100" placeholder="e.g. B.Pharm">
              </div>

              <div class="form-group">
                <label for="studentSession">Academic Session *</label>
                <input class="form-control" id="studentSession"
                       value="<%= principal.session || '2025-26' %>" required>
              </div>

              <div class="form-group">
                <label for="studentEmail">Email (Optional)</label>
                <input class="form-control" id="studentEmail"
                       type="email" maxlength="150" placeholder="student@example.com">
              </div>
            </div>

            <div class="form-actions">
              <button type="submit" class="btn btn-primary" id="studentSaveBtn">
                Add Student
              </button>
              <button type="button" class="btn btn-secondary" id="studentCancelBtn">
                Clear Form
              </button>
            </div>
          </form>

          <div id="studentMessage" class="message" role="status" aria-live="polite"></div>

          <div style="display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap">
            <h3 style="margin:0 0 14px">Student Records</h3>
            <input class="search" id="studentSearch"
                   aria-label="Search students"
                   placeholder="Search name, enrollment, course..."
                   style="margin-bottom:14px">
          </div>

          <div class="table-wrap">
            <table id="studentTable">
              <thead>
                <tr>
                  <th>Name</th>
                  <th>Enrollment</th>
                  <th>Mobile</th>
                  <th>Course</th>
                  <th>Session</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody id="studentTableBody">
                <tr><td colspan="6" class="empty-cell">Loading students...</td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </section>

      
<!-- FACULTY -->
<section class="section" id="faculty">
  <div class="panel">
    <h3>👨‍🏫 Faculty Management</h3>

    <div id="facultyMessage" class="message" role="status" aria-live="polite"></div>

    <form id="facultyForm" class="student-form">
      <h3 id="facultyFormTitle">Add Faculty Profile</h3>
      <input type="hidden" id="facultyProfileId">

      <div class="form-grid">
        <div class="form-group">
          <label for="facultyUserId">Faculty Account *</label>
          <select class="form-control" id="facultyUserId" required>
            <option value="">Select faculty account</option>
            <% if (facultyList && facultyList.length) { %>
              <% facultyList.filter(f => !f.hasProfile).forEach(f => { %>
                <option value="<%= f._id %>">
                  <%= f.name %> — <%= f.enrollment %>
                </option>
              <% }) %>
            <% } %>
          </select>
        </div>

        <div class="form-group">
          <label for="facultyDepartment">Department *</label>
          <input class="form-control" id="facultyDepartment"
                 required maxlength="100" placeholder="e.g. Pharmacy">
        </div>

        <div class="form-group">
          <label for="facultyDesignation">Designation</label>
          <input class="form-control" id="facultyDesignation"
                 maxlength="100" placeholder="e.g. Assistant Professor">
        </div>

        <div class="form-group">
          <label for="facultyQualification">Qualification</label>
          <input class="form-control" id="facultyQualification"
                 maxlength="150" placeholder="e.g. M.Pharm">
        </div>

        <div class="form-group">
          <label for="facultyMobile">Mobile</label>
          <input class="form-control" id="facultyMobile"
                 maxlength="15" placeholder="Mobile number">
        </div>

        <div class="form-group">
          <label for="facultyEmail">Email</label>
          <input class="form-control" id="facultyEmail"
                 type="email" maxlength="150" placeholder="faculty@example.com">
        </div>
      </div>

      <div class="form-actions">
        <button type="submit" class="btn btn-primary" id="facultySaveBtn">
          Add Profile
        </button>
        <button type="button" class="btn btn-secondary" id="facultyCancelBtn">
          Clear Form
        </button>
      </div>
      <p class="muted">
        Faculty account पहले से User Management में बना होना चाहिए।
      </p>
    </form>

    <input class="search" id="facultySearch"
           placeholder="Search faculty name or enrollment...">

    <div class="table-wrap">
      <table id="facultyTable">
        <thead>
          <tr>
            <th>Name</th>
            <th>Enrollment</th>
            <th>Department</th>
            <th>Designation</th>
            <th>Mobile</th>
            <th>Status</th>
            <th>Subjects</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (facultyList && facultyList.length) { %>
            <% facultyList.forEach(f => { %>
              <tr>
                <td><%= f.name || "—" %></td>
                <td><%= f.enrollment || "—" %></td>
                <td><%= f.department || "—" %></td>
                <td><%= f.designation || "—" %></td>
                <td><%= f.mobile || "—" %></td>
                <td><%= f.active ? "Active" : "Inactive" %></td>
                <td>
                  <% if (f.hasProfile) { %>
                    <button type="button" class="btn btn-primary"
                      onclick="openFacultySubjects('<%= f.profileId %>')">
                      Assign Subjects
                    </button>
                  <% } else { %>
                    <span class="muted">Create profile first</span>
                  <% } %>
                </td>
                <td>
                  <div class="table-actions">
                    <% if (f.hasProfile) { %>
                      <button type="button" class="btn btn-primary"
                        onclick="editFaculty('<%= f.profileId %>')">
                        Edit
                      </button>
                    <% } %>
                    <button type="button"
                      class="btn <%= f.active ? 'btn-danger' : 'btn-success' %>"
                      onclick="toggleFaculty('<%= f._id %>')">
                      <%= f.active ? "Deactivate" : "Activate" %>
                    </button>
                  </div>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr><td colspan="8" class="empty-cell">No faculty accounts found.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Subject assignment modal -->
