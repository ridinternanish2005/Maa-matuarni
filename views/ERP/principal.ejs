<!-- ATTENDANCE -->
<section class="section" id="attendance">
  <div class="panel">
    <h3>📅 Attendance Summary</h3>

    <div class="cards">
      <div class="stat-card blue">
        <div class="label">Total Records</div>
        <div class="number"><%= attendanceSummary?.total || 0 %></div>
      </div>

      <div class="stat-card green">
        <div class="label">Present</div>
        <div class="number"><%= attendanceSummary?.present || 0 %></div>
      </div>

      <div class="stat-card orange">
        <div class="label">Absent</div>
        <div class="number"><%= attendanceSummary?.absent || 0 %></div>
      </div>

      <div class="stat-card purple">
        <div class="label">Leave</div>
        <div class="number"><%= attendanceSummary?.leave || 0 %></div>
      </div>
    </div>

    <p>
      Attendance Percentage:
      <strong><%= attendanceSummary?.percentage || 0 %>%</strong>
    </p>

    <h3>Student Attendance Records</h3>

    <input
      class="search"
      id="attendanceSearch"
      placeholder="Search enrollment, subject or status..."
    >

    <div class="table-wrap">
      <table id="attendanceTable">
        <thead>
          <tr>
            <th>Enrollment</th>
            <th>Date</th>
            <th>Subject</th>
            <th>Status</th>
            <th>Session</th>
            <th>Remarks</th>
          </tr>
        </thead>

        <tbody>
          <% if (attendanceList && attendanceList.length) { %>
            <% attendanceList.forEach(record => { %>
              <tr>
                <td><%= record.enrollment || "—" %></td>
                <td>
                  <%= record.date
                    ? new Date(record.date).toLocaleDateString("en-IN")
                    : "—" %>
                </td>
                <td><%= record.subject || "—" %></td>
                <td><%= record.status || "—" %></td>
                <td><%= record.session || "—" %></td>
                <td><%= record.remarks || "—" %></td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="6" class="empty-cell">
                No attendance records found for this session.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</section>

   
<!-- FEES -->
<section class="section" id="fees">
  <div class="panel">
    <h3>💰 Fee Management Summary</h3>

    <div class="cards">
      <div class="stat-card blue">
