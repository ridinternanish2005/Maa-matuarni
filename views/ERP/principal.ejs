      </div>

      <div class="stat-card orange">
        <div class="label">Pending Fees</div>
        <div class="number">
          ₹<%= Number(feeSummary?.pendingFees || 0).toLocaleString("en-IN") %>
        </div>
      </div>
    </div>

    <p class="muted">
      Active fee records: <strong><%= feeSummary?.records || 0 %></strong>
    </p>

    <h3>Student-wise Fee Report</h3>

    <input
      class="search"
      id="feeSearch"
      placeholder="Search student, enrollment or course..."
    >

