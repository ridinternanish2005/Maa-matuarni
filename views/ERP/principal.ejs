</div>

<script>
(function () {
  const sidebar = document.getElementById("principalSidebar");
  const toggle = document.getElementById("menuToggle");
  const overlay = document.getElementById("sidebarOverlay");

  if (!sidebar || !toggle || !overlay) {
    console.error("Principal sidebar toggle elements missing.");
    return;
  }

  function openSidebar() {
    sidebar.classList.add("open");
    overlay.classList.add("active");
    toggle.setAttribute("aria-expanded", "true");
  }

  function closeSidebar() {
    sidebar.classList.remove("open");
    overlay.classList.remove("active");
    toggle.setAttribute("aria-expanded", "false");
  }

  toggle.addEventListener("click", function () {
    sidebar.classList.contains("open")
      ? closeSidebar()
      : openSidebar();
  });

  overlay.addEventListener("click", closeSidebar);

  sidebar.querySelectorAll("button, a, [data-view]").forEach(function (item) {
    item.addEventListener("click", function () {
      if (window.innerWidth <= 900) closeSidebar();
    });
  });

  document.addEventListener("keydown", function (event) {
    if (event.key === "Escape") closeSidebar();
  });

  window.addEventListener("resize", function () {
    if (window.innerWidth > 900) closeSidebar();
  });
})();

  // ---------------- NAVIGATION ----------------
  const navButtons = document.querySelectorAll(".nav-btn");
  const sections = document.querySelectorAll(".section");
  const pageTitle = document.getElementById("pageTitle");
  const sidebar = document.getElementById("sidebar");

  navButtons.forEach(button => {
    button.addEventListener("click", () => {
      const target = button.dataset.section;
      const targetSection = document.getElementById(target);

      if (!targetSection) return;

      navButtons.forEach(item => item.classList.remove("active"));
      sections.forEach(section => section.classList.remove("active"));

      button.classList.add("active");
      targetSection.classList.add("active");
      pageTitle.textContent = button.textContent.trim();
      sidebar.classList.remove("open");

      if (target === "students") loadStudents();
    });
  });

  document.getElementById("menuToggle").addEventListener("click", () => {
    sidebar.classList.toggle("open");
  });

  document.getElementById("printReport").addEventListener("click", () => {
    window.print();
  });

  // ---------------- TABLE SEARCH ----------------
  function addTableSearch(inputId, tableId) {
    const input = document.getElementById(inputId);
    const table = document.getElementById(tableId);
    addTableSearch("feeSearch", "feeTable");
    if (!input || !table) return;

    input.addEventListener("input", () => {
      const query = input.value.toLowerCase();

      table.querySelectorAll("tbody tr").forEach(row => {
        row.style.display =
          row.textContent.toLowerCase().includes(query) ? "" : "none";
      });
    });
  }

  addTableSearch("facultySearch", "facultyTable");
  addTableSearch("attendanceSearch", "attendanceTable");
const facultyForm = document.getElementById("facultyForm");
const facultyMessage = document.getElementById("facultyMessage");
const facultyProfileId = document.getElementById("facultyProfileId");
const facultyUserId = document.getElementById("facultyUserId");
const facultySubjectPanel = document.getElementById("facultySubjectPanel");

let assignmentCourses = [];
let selectedAssignments = [];

function showFacultyMessage(message, type = "success") {
  facultyMessage.textContent = message;
  facultyMessage.className = "message show " + type;
}

async function facultyRequest(url, method = "GET", body) {
  const options = {
    method,
    headers: { Accept: "application/json" }
  };

  if (body !== undefined) {
    options.headers["Content-Type"] = "application/json";
    options.body = JSON.stringify(body);
  }

  const response = await fetch(url, options);
  const data = await response.json().catch(() => ({}));

  if (!response.ok || data.success === false) {
    throw new Error(data.message || data.error || "Request failed.");
  }

  return data;
}

function clearFacultyForm() {
  facultyForm.reset();
  facultyProfileId.value = "";
  facultyUserId.disabled = false;
  document.getElementById("facultyFormTitle").textContent = "Add Faculty Profile";
  document.getElementById("facultySaveBtn").textContent = "Add Profile";
  facultyMessage.className = "message";
}

document.getElementById("facultyCancelBtn").addEventListener("click", clearFacultyForm);

facultyForm.addEventListener("submit", async event => {
  event.preventDefault();

  const profileId = facultyProfileId.value;
  const payload = {
    department: document.getElementById("facultyDepartment").value.trim(),
    designation: document.getElementById("facultyDesignation").value.trim(),
    qualification: document.getElementById("facultyQualification").value.trim(),
    mobile: document.getElementById("facultyMobile").value.trim(),
    email: document.getElementById("facultyEmail").value.trim()
  };

  if (!payload.department) {
    showFacultyMessage("Department is required.", "error");
    return;
  }

  try {
    if (profileId) {
      await facultyRequest(
        `/erp/faculty-management/${encodeURIComponent(profileId)}`,
        "PUT",
        payload
      );
    } else {
      if (!facultyUserId.value) {
        showFacultyMessage("Select a faculty account first.", "error");
        return;
      }

      payload.userId = facultyUserId.value;

      await facultyRequest("/erp/faculty-management", "POST", payload);
    }

    alert(profileId ? "Faculty profile updated." : "Faculty profile created.");
    window.location.reload();
  } catch (error) {
    showFacultyMessage(error.message, "error");
  }
});

async function editFaculty(profileId) {
  try {
    // The existing dashboard data is used to fill the form.
    const row = [...document.querySelectorAll("#facultyTable tbody tr")]
      .find(tr => tr.querySelector(`button[onclick*="${profileId}"]`));

    if (!row) throw new Error("Faculty row not found.");

    const cells = row.querySelectorAll("td");
    facultyProfileId.value = profileId;
    facultyUserId.disabled = true;

    document.getElementById("facultyDepartment").value =
      cells[2].textContent.trim() === "—" ? "" : cells[2].textContent.trim();

    document.getElementById("facultyDesignation").value =
      cells[3].textContent.trim() === "—" ? "" : cells[3].textContent.trim();

    document.getElementById("facultyMobile").value =
      cells[4].textContent.trim() === "—" ? "" : cells[4].textContent.trim();

    document.getElementById("facultyFormTitle").textContent = "Edit Faculty Profile";
    document.getElementById("facultySaveBtn").textContent = "Update Profile";

    showFacultyMessage(
      "Edit the visible fields. Qualification and email can also be updated.",
      "success"
    );

    facultyForm.scrollIntoView({ behavior: "smooth", block: "start" });
  } catch (error) {
    showFacultyMessage(error.message, "error");
  }
}

async function toggleFaculty(userId) {
  if (!confirm("Are you sure you want to change this faculty account's status?")) {
    return;
  }

  try {
    await facultyRequest(
      `/erp/faculty-management/${encodeURIComponent(userId)}/status`,
      "PATCH"
    );
    window.location.reload();
  } catch (error) {
    showFacultyMessage(error.message, "error");
  }
}

const subjectCourse = document.getElementById("subjectCourse");
const subjectSemester = document.getElementById("subjectSemester");
const subjectSubject = document.getElementById("subjectSubject");
const assignedSubjectRows = document.getElementById("assignedSubjectRows");
const subjectMessage = document.getElementById("subjectMessage");

function fillSelect(select, items, labelFunction, valueFunction) {
  select.replaceChildren(new Option("Select", ""));

  items.forEach(item => {
    select.add(new Option(labelFunction(item), valueFunction(item)));
  });
}

async function openFacultySubjects(profileId) {
  try {
    document.getElementById("subjectProfileId").value = profileId;
    selectedAssignments = [];
    renderSelectedAssignments();

    const data = await facultyRequest("/erp/faculty-management/assignment-courses");
    assignmentCourses = data.courses || data.courseList || [];

    fillSelect(
      subjectCourse,
      assignmentCourses,
      course => course.courseName || course.name || course.courseCode || "Course",
      course => course._id
    );

    subjectSemester.replaceChildren(new Option("Select semester", ""));
    subjectSubject.replaceChildren(new Option("Select subject", ""));

    facultySubjectPanel.style.display = "block";
    subjectMessage.className = "message";
    facultySubjectPanel.scrollIntoView({ behavior: "smooth", block: "start" });
  } catch (error) {
    showFacultyMessage(error.message, "error");
  }
}

subjectCourse.addEventListener("change", () => {
  const course = assignmentCourses.find(c => String(c._id) === subjectCourse.value);
  const semesters = course?.semesters || [];

  fillSelect(
    subjectSemester,
    semesters,
    semester => semester.semesterName || semester.name || semester.semesterNumber || semester.semester || "Semester",
    semester => semester._id
  );

  subjectSubject.replaceChildren(new Option("Select subject", ""));
});

subjectSemester.addEventListener("change", () => {
  const course = assignmentCourses.find(c => String(c._id) === subjectCourse.value);
  const semester = (course?.semesters || []).find(
    s => String(s._id) === subjectSemester.value
  );

  const subjects = semester?.subjects || [];

  fillSelect(
    subjectSubject,
    subjects,
    subject => subject.subjectName || subject.name || subject.title || "Subject",
    subject => subject._id
  );
});

document.getElementById("addSubjectBtn").addEventListener("click", () => {
  if (!subjectCourse.value || !subjectSemester.value || !subjectSubject.value) {
    subjectMessage.textContent = "Select course, semester and subject.";
    subjectMessage.className = "message show error";
    return;
  }

  const key = `${subjectCourse.value}|${subjectSemester.value}|${subjectSubject.value}`;

  if (selectedAssignments.some(item => item.key === key)) {
    subjectMessage.textContent = "This subject is already in the list.";
    subjectMessage.className = "message show error";
    return;
  }

  const course = assignmentCourses.find(c => String(c._id) === subjectCourse.value);
  const semester = course.semesters.find(s => String(s._id) === subjectSemester.value);
  const subject = semester.subjects.find(s => String(s._id) === subjectSubject.value);

  selectedAssignments.push({
    key,
    courseId: subjectCourse.value,
    semesterId: subjectSemester.value,
    subjectId: subjectSubject.value,
    courseName: course.courseName || course.name || course.courseCode || "Course",
    semesterName: semester.semesterName || semester.name || semester.semesterNumber || "Semester",
    subjectName: subject.subjectName || subject.name || subject.title || "Subject"
  });

  subjectMessage.className = "message";
  renderSelectedAssignments();
});

function renderSelectedAssignments() {
  assignedSubjectRows.replaceChildren();

  if (!selectedAssignments.length) {
    const row = assignedSubjectRows.insertRow();
    const cell = row.insertCell();
    cell.colSpan = 4;
    cell.className = "empty-cell";
    cell.textContent = "No subjects in the list.";
    return;
  }

  selectedAssignments.forEach((item, index) => {
    const row = assignedSubjectRows.insertRow();
    row.insertCell().textContent = item.courseName;
    row.insertCell().textContent = item.semesterName;
    row.insertCell().textContent = item.subjectName;

    const actionCell = row.insertCell();
    const button = document.createElement("button");
    button.type = "button";
    button.className = "btn btn-danger";
    button.textContent = "Remove";
    button.addEventListener("click", () => {
      selectedAssignments.splice(index, 1);
      renderSelectedAssignments();
    });
    actionCell.appendChild(button);
  });
}

document.getElementById("saveSubjectsBtn").addEventListener("click", async () => {
  if (!selectedAssignments.length) {
    subjectMessage.textContent = "Add at least one subject before saving.";
    subjectMessage.className = "message show error";
    return;
  }

  try {
    await facultyRequest(
      `/erp/faculty-management/${encodeURIComponent(
        document.getElementById("subjectProfileId").value
      )}/subjects`,
      "PUT",
      {
        subjectAssignments: selectedAssignments.map(item => ({
          courseId: item.courseId,
          semesterId: item.semesterId,
          subjectId: item.subjectId
        }))
      }
    );

    alert("Faculty subjects assigned successfully.");
    window.location.reload();
  } catch (error) {
    subjectMessage.textContent = error.message;
    subjectMessage.className = "message show error";
  }
});

document.getElementById("closeSubjectsBtn").addEventListener("click", () => {
  facultySubjectPanel.style.display = "none";
});


  // ---------------- STUDENT MANAGEMENT ----------------
  const studentForm = document.getElementById("studentForm");
  const studentBody = document.getElementById("studentTableBody");
  const studentMessage = document.getElementById("studentMessage");
  const studentSearch = document.getElementById("studentSearch");

  const defaultSession = "<%= principal.session || '2025-26' %>";
  let allStudents = [];

  function showStudentMessage(message, type = "success") {
    studentMessage.textContent = message;
    studentMessage.className = "message show " + type;
  }

  function clearStudentMessage() {
    studentMessage.textContent = "";
    studentMessage.className = "message";
  }

  function makeCell(value) {
    const cell = document.createElement("td");
    cell.textContent = value || "—";
    return cell;
  }

  async function loadStudents() {
    studentBody.replaceChildren();

    const loadingRow = document.createElement("tr");
    const loadingCell = document.createElement("td");
    loadingCell.colSpan = 6;
    loadingCell.className = "empty-cell";
    loadingCell.textContent = "Loading students...";
    loadingRow.appendChild(loadingCell);
    studentBody.appendChild(loadingRow);

    try {
      const response = await fetch("/api/students", {
        method: "GET",
        headers: { "Accept": "application/json" }
      });

      const data = await response.json();

      if (!response.ok || !data.success) {
        throw new Error(data.message || "Students load nahi hue.");
      }

      allStudents = data.students || [];
      renderStudents();
    } catch (error) {
      studentBody.replaceChildren();

      const row = document.createElement("tr");
      const cell = document.createElement("td");
      cell.colSpan = 6;
      cell.className = "empty-cell";
      cell.textContent = error.message || "Students load nahi hue. Server check karein.";
      row.appendChild(cell);
      studentBody.appendChild(row);

      showStudentMessage(error.message || "Students load nahi hue.", "error");
    }
  }

  function renderStudents() {
    const query = studentSearch.value.trim().toLowerCase();

    const filtered = allStudents.filter(student => {
      const searchable = [
        student.name,
        student.enrollment,
        student.course,
        student.mobile,
        student.session,
        student.email
      ];

      return searchable.some(value =>
        String(value || "").toLowerCase().includes(query)
      );
    });

    studentBody.replaceChildren();

    if (filtered.length === 0) {
      const row = document.createElement("tr");
      const cell = document.createElement("td");
      cell.colSpan = 6;
      cell.className = "empty-cell";
      cell.textContent = query
        ? "Search se koi student nahi mila."
        : "Abhi koi student record nahi hai. Add Student form ka use karein.";
      row.appendChild(cell);
      studentBody.appendChild(row);
      return;
    }

    filtered.forEach(student => {
      const row = document.createElement("tr");

      row.appendChild(makeCell(student.name));
      row.appendChild(makeCell(student.enrollment));
      row.appendChild(makeCell(student.mobile));
      row.appendChild(makeCell(student.course));
      row.appendChild(makeCell(student.session));

      const actions = document.createElement("td");
      const actionWrap = document.createElement("div");
      actionWrap.className = "table-actions";

      const editButton = document.createElement("button");
      editButton.type = "button";
      editButton.className = "btn btn-primary";
      editButton.textContent = "Edit";
      editButton.addEventListener("click", () => editStudent(student._id));

      const deleteButton = document.createElement("button");
      deleteButton.type = "button";
      deleteButton.className = "btn btn-danger";
      deleteButton.textContent = "Delete";
      deleteButton.addEventListener("click", () => deleteStudent(student._id));

      actionWrap.append(editButton, deleteButton);
      actions.appendChild(actionWrap);
      row.appendChild(actions);
      studentBody.appendChild(row);
    });
  }

  studentSearch.addEventListener("input", renderStudents);

  // Add or update student
  studentForm.addEventListener("submit", async event => {
    event.preventDefault();
    clearStudentMessage();

    const id = document.getElementById("studentId").value.trim();

    const student = {
      enrollment: document.getElementById("studentEnrollment").value.trim().toUpperCase(),
      name: document.getElementById("studentName").value.trim(),
      mobile: document.getElementById("studentMobile").value.trim(),
      course: document.getElementById("studentCourse").value.trim(),
      session: document.getElementById("studentSession").value.trim(),
      email: document.getElementById("studentEmail").value.trim()
    };

    if (!student.enrollment || !student.name || !student.mobile ||
        !student.course || !student.session) {
      showStudentMessage("Please saari required fields fill karein.", "error");
      return;
    }

    const saveButton = document.getElementById("studentSaveBtn");
    saveButton.disabled = true;
    saveButton.textContent = id ? "Updating..." : "Saving...";

    try {
      const response = await fetch(
        id ? `/api/students/${encodeURIComponent(id)}` : "/api/students",
        {
          method: id ? "PUT" : "POST",
          headers: { "Content-Type": "application/json", "Accept": "application/json" },
          body: JSON.stringify(student)
        }
      );

      const data = await response.json();

      if (!response.ok || !data.success) {
        throw new Error(data.message || "Student save nahi hua.");
      }

      studentForm.reset();
      document.getElementById("studentId").value = "";
      document.getElementById("studentSession").value = defaultSession;
      saveButton.textContent = "Add Student";

      await loadStudents();
      showStudentMessage(data.message || (id
        ? "Student updated successfully."
        : "Student added successfully."), "success");
    } catch (error) {
      showStudentMessage(error.message || "Student save nahi hua.", "error");
    } finally {
      saveButton.disabled = false;
      saveButton.textContent =
        document.getElementById("studentId").value ? "Update Student" : "Add Student";
    }
  });

  // Fill form for editing
  function editStudent(id) {
    const student = allStudents.find(item => String(item._id) === String(id));

    if (!student) {
      showStudentMessage("Student record nahi mila. List refresh karein.", "error");
      return;
    }

    document.getElementById("studentId").value = student._id;
    document.getElementById("studentEnrollment").value = student.enrollment || "";
    document.getElementById("studentName").value = student.name || "";
    document.getElementById("studentMobile").value = student.mobile || "";
    document.getElementById("studentCourse").value = student.course || "";
    document.getElementById("studentSession").value = student.session || defaultSession;
    document.getElementById("studentEmail").value = student.email || "";
    document.getElementById("studentSaveBtn").textContent = "Update Student";

    showStudentMessage(
      "Details edit karein, phir Update Student button dabayein.",
      "success"
    );

    studentForm.scrollIntoView({ behavior: "smooth", block: "start" });
    document.getElementById("studentName").focus();
  }

  // Delete student
  async function deleteStudent(id) {
    const student = allStudents.find(item => String(item._id) === String(id));
    if (!student) return;

    const confirmed = confirm(
      `Kya aap "${student.name || "is student"}" (${student.enrollment || ""}) ko delete karna chahte hain?`
    );

    if (!confirmed) return;

    try {
      const response = await fetch(
        `/api/students/${encodeURIComponent(id)}`,
        {
          method: "DELETE",
          headers: { "Accept": "application/json" }
        }
      );

      const data = await response.json();

      if (!response.ok || !data.success) {
        throw new Error(data.message || "Student delete nahi hua.");
      }

      await loadStudents();
      showStudentMessage(data.message || "Student deleted successfully.", "success");
    } catch (error) {
      showStudentMessage(error.message || "Student delete nahi hua.", "error");
    }
  }

  // Clear form / cancel edit
  document.getElementById("studentCancelBtn").addEventListener("click", () => {
    studentForm.reset();
    document.getElementById("studentId").value = "";
    document.getElementById("studentSession").value = defaultSession;
    document.getElementById("studentSaveBtn").textContent = "Add Student";
    clearStudentMessage();
  });

  // Initial data load
  loadStudents();
</script>

</body>
</html>