<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>
    Faculty Dashboard - Maa Maturani Devi Pharmacy College
  </title>

  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
  >

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
  >

  <link
    rel="stylesheet"
    href="/css/faculty.css"
  >

</head>


<body>

<div class="dashboard-wrapper">


  <!-- ========================================= -->
  <!-- SIDEBAR -->
  <!-- ========================================= -->

  <aside class="sidebar">

    <div class="sidebar-header">

      <div class="erp-code-big">
        <%= erpUser?.enrollment || "Faculty" %>
      </div>

      <span class="erp-session-badge">
        <%= erpUser?.session || "2025-26" %>
      </span>

    </div>


    <div class="nav-caption">
      FACULTY PANEL
    </div>


    <nav class="faculty-nav">


      <button
        type="button"
        class="nav-item active"
        data-view="dashboardView"
      >

        <i class="fas fa-tachometer-alt"></i>

        <span>
          Dashboard
        </span>

      </button>


      <button
        type="button"
        class="nav-item"
        data-view="myCoursesView"
      >

        <i class="fas fa-book-open"></i>

        <span>
          My Courses
        </span>

      </button>


      <button
        type="button"
        class="nav-item"
        data-view="attendanceView"
      >

        <i class="fas fa-calendar-check"></i>

        <span>
          Mark Attendance
        </span>

      </button>


      <button
        type="button"
        class="nav-item"
        data-view="marksView"
      >

        <i class="fas fa-edit"></i>

        <span>
          Upload Marks
        </span>

      </button>


      <button
        type="button"
        class="nav-item"
        data-view="studentListView"
      >

        <i class="fas fa-users"></i>

        <span>
          Student List
        </span>

      </button>


      <button
        type="button"
        class="nav-item"
        data-view="timetableView"
      >

        <i class="fas fa-clock"></i>

        <span>
          Time Table
        </span>

      </button>


      <button
        type="button"
        class="nav-item"
        data-view="leaveView"
      >

        <i class="fas fa-umbrella-beach"></i>

        <span>
          Leave Application
        </span>

      </button>


      <button
        type="button"
        class="nav-item"
        data-view="noticesView"
      >

        <i class="fas fa-bullhorn"></i>

        <span>
          Notices
        </span>

      </button>


      <button
        type="button"
        class="nav-item"
        data-view="changePwdView"
      >

        <i class="fas fa-key"></i>

        <span>
          Change Password
        </span>

      </button>


    </nav>


    <div class="sidebar-footer">

      <div class="faculty-user">

        <i class="fas fa-chalkboard-teacher"></i>

        <span>
          <%= erpUser?.name || "Faculty" %>
          • Faculty
        </span>

      </div>


      <div class="copyright">
        © Maa Maturani Devi Pharmacy College
      </div>

    </div>

  </aside>



  <!-- ========================================= -->
  <!-- MAIN CONTENT -->
  <!-- ========================================= -->

  <main class="main-content">


    <!-- HEADER -->

    <header class="erp-header">

      <div>

        <div class="erp-title">
          CollegeERP
        </div>

        <div class="erp-subtitle">
          Faculty Dashboard
        </div>

      </div>


      <div class="erp-code-area">

        <span class="erp-code">
          <%= erpUser?.enrollment || "Faculty" %>
        </span>

        <span class="erp-session">
          <%= erpUser?.session || "2025-26" %>
        </span>

      </div>

    </header>



    <!-- ========================================= -->
    <!-- DASHBOARD -->
    <!-- ========================================= -->

    <section
      id="dashboardView"
      class="view active-view"
    >

      <h1 class="page-title">
        Faculty Dashboard
      </h1>

      <p class="page-description">
        Welcome,
        <strong>
          <%= erpUser?.name || "Faculty" %>
        </strong>.
        Manage your academic activities from here.
      </p>


      <!-- STATS -->

      <div class="stats-grid">


        <div class="stat-card">

          <div class="stat-label">
            My Courses
          </div>

          <div class="stat-number">
            <%= dashboardStats?.totalCourses || 0 %>
          </div>

          <div class="stat-sub">
            Assigned subjects
          </div>

        </div>


        <div class="stat-card">

          <div class="stat-label">
            Total Students
          </div>

          <div class="stat-number">
            <%= dashboardStats?.totalStudents || 0 %>
          </div>

          <div class="stat-sub">
            Current session
          </div>

        </div>


        <div class="stat-card">

          <div class="stat-label">
            Today's Classes
          </div>

          <div class="stat-number">
            <%= dashboardStats?.todaysClasses || 0 %>
          </div>

          <div class="stat-sub">
            Scheduled today
          </div>

        </div>


        <div class="stat-card">

          <div class="stat-label">
            Pending Tasks
          </div>

          <div class="stat-number">
            <%= dashboardStats?.pendingTasks || 0 %>
          </div>

          <div class="stat-sub">
            Marks / requests
          </div>

        </div>

      </div>



      <!-- COURSES + TODAY -->

      <div class="row-2col">


        <!-- COURSES -->

        <div class="card">

          <div class="card-title">

            <i class="fas fa-book-open"></i>

            My Assigned Courses

          </div>


          <% if (courses && courses.length > 0) { %>

            <% courses.forEach(function(course) { %>

              <div class="course-item">

                <strong>
                  <%= course.name %>
                </strong>

              </div>

            <% }); %>

          <% } else { %>

            <div class="empty-state">

              <i class="fas fa-book-open"></i>

              <p>
                No subjects assigned yet.
              </p>

            </div>

          <% } %>

        </div>



        <!-- TODAY SCHEDULE -->

        <div class="card">

          <div class="card-title">

            <i class="fas fa-calendar-alt"></i>

            Today's Schedule

          </div>


          <% if (todaysTimetable && todaysTimetable.length > 0) { %>

            <% todaysTimetable.forEach(function(item) { %>

              <div class="schedule-item">

                <div class="schedule-subject">
                  <%= item.subject %>
                </div>

                <div class="schedule-time">

                  <i class="fas fa-clock"></i>

                  <%= item.startTime %>
                  -
                  <%= item.endTime %>

                </div>

                <div class="schedule-info">

                  <%= item.course %>
                  •
                  <%= item.semester %>
                  •
                  Room
                  <%= item.roomNumber || "-" %>

                </div>

              </div>

            <% }); %>

          <% } else { %>

            <div class="empty-state">

              <i class="fas fa-calendar-xmark"></i>

              <p>
                No classes scheduled for today.
              </p>

            </div>

          <% } %>

        </div>

      </div>



      <!-- RECENT + QUICK ACTION -->

      <div class="row-2col">


        <div class="card">

          <div class="card-title">

            <i class="fas fa-history"></i>

            Recent Activity

          </div>


          <div class="activity-item">

            Faculty profile loaded successfully.

          </div>


          <div class="activity-item">

            <%= dashboardStats?.totalStudents || 0 %>

            active students found.

          </div>


          <div class="activity-item">

            <%= dashboardStats?.totalCourses || 0 %>

            subjects assigned.

          </div>

        </div>



        <div class="card">

          <div class="card-title">

            <i class="fas fa-bolt"></i>

            Quick Actions

          </div>


          <div class="quick-actions">

            <button
              type="button"
              class="btn-primary"
              data-view="attendanceView"
            >

              <i class="fas fa-calendar-check"></i>

              Mark Attendance

            </button>


            <button
              type="button"
              class="btn-outline"
              data-view="marksView"
            >

              <i class="fas fa-edit"></i>

              Upload Marks

            </button>

          </div>

        </div>

      </div>

    </section>



    <!-- ========================================= -->
    <!-- MY COURSES -->
    <!-- ========================================= -->

    <section
      id="myCoursesView"
      class="view"
    >

      <h1 class="page-title">
        My Courses
      </h1>

      <p class="page-description">
        Subjects assigned to you.
      </p>


      <div class="card">

        <div class="card-title">

          <i class="fas fa-book"></i>

          Assigned Subjects

        </div>


        <% if (courses && courses.length > 0) { %>

          <div class="table-responsive">

            <table>

            
<thead>
  <tr>
    <th>#</th>
    <th>Course</th>
    <th>Semester</th>
    <th>Subject</th>
    <th>Subject Code</th>
    <th>Type</th>
    <th>Credits</th>
  </tr>
</thead>

<tbody>
  <% courses.forEach(function(course, index) { %>
    <tr>
      <td><%= index + 1 %></td>
      <td><%= course.courseName || "Not linked" %></td>
      <td>
        <%= course.semesterName || "Not linked" %>
      </td>
      <td>
        <strong><%= course.name %></strong>
      </td>
      <td><%= course.subjectCode || "-" %></td>
      <td><%= course.type || "-" %></td>
      <td><%= course.credits ?? "-" %></td>
    </tr>
  <% }); %>
</tbody>


            </table>

          </div>

        <% } else { %>

          <div class="empty-state">

            <i class="fas fa-book"></i>

            <p>
              No courses assigned.
            </p>

          </div>

        <% } %>

      </div>

    </section>



    <!-- ========================================= -->
    <!-- ATTENDANCE -->
    <!-- ========================================= -->

    <section
      id="attendanceView"
      class="view"
    >

      <h1 class="page-title">
        Mark Attendance
      </h1>

      <p class="page-description">
        Faculty attendance module.
      </p>


      <div class="card module-card">

        <div class="module-icon">

          <i class="fas fa-calendar-check"></i>

        </div>

        <h2>
          Attendance Management
        </h2>

        <p>
          Open the attendance module to mark student attendance.
        </p>

        <a
          href="/erp/faculty/attendance"
          class="btn-primary"
        >

          <i class="fas fa-arrow-right"></i>

          Open Attendance

        </a>

      </div>

    </section>



    <!-- ========================================= -->
    <!-- MARKS -->
    <!-- ========================================= -->

    <section
      id="marksView"
      class="view"
    >

      <h1 class="page-title">
        Upload Marks
      </h1>

      <p class="page-description">
        Faculty marks management module.
      </p>


      <div class="card module-card">

        <div class="module-icon">

          <i class="fas fa-edit"></i>

        </div>

        <h2>
          Marks Management
        </h2>

        <p>
          Open the marks module to upload and manage student marks.
        </p>

        <a
          href="/erp/faculty/marks"
          class="btn-primary"
        >

          <i class="fas fa-arrow-right"></i>

          Open Marks

        </a>

      </div>

    </section>



    <!-- ========================================= -->
    <!-- STUDENT LIST -->
    <!-- ========================================= -->

    <section
      id="studentListView"
      class="view"
    >

      <h1 class="page-title">
        Student List
      </h1>

      <p class="page-description">

        Active students of
        <%= user?.session || "" %>.

      </p>


      <div class="card">

        <div class="card-title">

          <i class="fas fa-users"></i>

          Students

        </div>


        <% if (students && students.length > 0) { %>

          <div class="table-responsive">

            <table>

              <thead>

                <tr>

                  <th>#</th>

                  <th>
                    Enrollment
                  </th>

                  <th>
                    Student Name
                  </th>

                  <th>
                    Session
                  </th>

                  <th>
                    Status
                  </th>

                </tr>

              </thead>


              <tbody>

                <% students.forEach(function(student, index) { %>

                  <tr>

                    <td>
                      <%= index + 1 %>
                    </td>

                    <td>
                      <strong>
                        <%= student.enrollment %>
                      </strong>
                    </td>

                    <td>
                      <%= student.name %>
                    </td>

                    <td>
                      <%= student.session %>
                    </td>

                    <td>

                      <% if (student.active) { %>

                        <span class="status-badge active">
                          Active
                        </span>

                      <% } else { %>

                        <span class="status-badge inactive">
                          Inactive
                        </span>

                      <% } %>

                    </td>

                  </tr>

                <% }); %>

              </tbody>

            </table>

          </div>

        <% } else { %>

          <div class="empty-state">

            <i class="fas fa-users"></i>

            <p>
              No active students found.
            </p>

          </div>

        <% } %>

      </div>

    </section>



    <!-- ========================================= -->
    <!-- TIMETABLE -->
    <!-- ========================================= -->

    <section
      id="timetableView"
      class="view"
    >

      <h1 class="page-title">
        Faculty Time Table
      </h1>

      <p class="page-description">
        Your weekly teaching schedule.
      </p>


      <div class="card">

        <div class="card-title">

          <i class="fas fa-clock"></i>

          Weekly Schedule

        </div>


        <% if (timetable && timetable.length > 0) { %>

          <div class="table-responsive">

            <table>

              <thead>

                <tr>

                  <th>#</th>
                  <th>Day</th>
                  <th>Time</th>
                  <th>Subject</th>
                  <th>Course</th>
                  <th>Semester</th>
                  <th>Room</th>

                </tr>

              </thead>


              <tbody>

                <% timetable.forEach(function(item, index) { %>

                  <tr>

                    <td>
                      <%= index + 1 %>
                    </td>

                    <td>
                      <strong>
                        <%= item.day %>
                      </strong>
                    </td>

                    <td>

                      <%= item.startTime %>
                      -
                      <%= item.endTime %>

                    </td>

                    <td>
                      <%= item.subject %>
                    </td>

                    <td>
                      <%= item.course %>
                    </td>

                    <td>
                      <%= item.semester %>
                    </td>

                    <td>
                      <%= item.roomNumber || "-" %>
                    </td>

                  </tr>

                <% }); %>

              </tbody>

            </table>

          </div>

        <% } else { %>

          <div class="empty-state">

            <i class="fas fa-calendar-xmark"></i>

            <p>
              No timetable available.
            </p>

          </div>

        <% } %>

      </div>

    </section>



    <!-- ========================================= -->
    <!-- LEAVE -->
    <!-- ========================================= -->

    <section
      id="leaveView"
      class="view"
    >

      <h1 class="page-title">
        Leave Application
      </h1>

      <p class="page-description">
        Submit your leave request.
      </p>


      <div class="card form-card">

        <form
          action="/erp/faculty/leave"
          method="POST"
        >

          <div class="form-group">

            <label>
              Leave Type
            </label>

            <select
              name="leaveType"
              class="form-control"
              required
            >

              <option value="">
                Select Leave Type
              </option>

              <option value="Casual">
                Casual
              </option>

              <option value="Medical">
                Medical
              </option>

              <option value="Other">
                Other
              </option>

            </select>

          </div>


          <div class="form-row">

            <div class="form-group">

              <label>
                From Date
              </label>

              <input
                type="date"
                name="fromDate"
                class="form-control"
                required
              >

            </div>


            <div class="form-group">

              <label>
                To Date
              </label>

              <input
                type="date"
                name="toDate"
                class="form-control"
                required
              >

            </div>

          </div>


          <div class="form-group">

            <label>
              Reason
            </label>

            <textarea
              name="reason"
              class="form-control"
              rows="5"
              placeholder="Enter reason for leave..."
              required
            ></textarea>

          </div>


          <button
            type="submit"
            class="btn-primary"
          >

            <i class="fas fa-paper-plane"></i>

            Submit Application

          </button>

        </form>

      </div>

    </section>



    <!-- ========================================= -->
    <!-- NOTICES -->
    <!-- ========================================= -->

    <section
      id="noticesView"
      class="view"
    >

      <h1 class="page-title">
        Institute Notices
      </h1>

      <p class="page-description">
        Latest notices published by the institute.
      </p>


      <div class="card">

        <div class="card-title">

          <i class="fas fa-bullhorn"></i>

          Notices

        </div>


        <% if (notices && notices.length > 0) { %>

          <div class="faculty-notices-list">


            <% notices.forEach(function(notice) { %>

              <div
                class="notice-card"
                style="
                  margin-bottom:18px;
                  padding:20px;
                  border:1px solid #e2e8f0;
                  border-radius:14px;
                  background:#ffffff;
                "
              >


                <div
                  style="
                    display:flex;
                    justify-content:space-between;
                    align-items:flex-start;
                    gap:15px;
                    flex-wrap:wrap;
                  "
                >

                  <div>

                    <h3
                      style="
                        margin:0 0 8px;
                        font-size:19px;
                      "
                    >

                      <%= notice.title %>

                    </h3>


                    <div
                      style="
                        display:flex;
                        gap:15px;
                        flex-wrap:wrap;
                        font-size:13px;
                        color:#64748b;
                      "
                    >

                      <span>

                        <i class="fas fa-tag"></i>

                        <%= notice.category || "General" %>

                      </span>


                      <span>

                        <i class="fas fa-calendar"></i>

                        <%= notice.noticeDate
                          ? new Date(notice.noticeDate)
                              .toLocaleDateString(
                                "en-IN",
                                {
                                  day:"2-digit",
                                  month:"short",
                                  year:"numeric"
                                }
                              )
                          : "-"
                        %>

                      </span>

                    </div>

                  </div>


                  <% if (notice.important) { %>

                    <span
                      class="status-badge active"
                    >
                      Important
                    </span>

                  <% } %>


                </div>


                <p
                  style="
                    margin:15px 0 0;
                    line-height:1.7;
                    color:#334155;
                  "
                >

                  <%= notice.description %>

                </p>


              </div>

            <% }); %>


          </div>

        <% } else { %>

          <div class="empty-state">

            <i class="fas fa-bullhorn"></i>

            <p>
              No notices available.
            </p>

          </div>

        <% } %>

      </div>

    </section>



    <!-- ========================================= -->
    <!-- CHANGE PASSWORD -->
    <!-- ========================================= -->

    <section
      id="changePwdView"
      class="view"
    >

      <h1 class="page-title">
        Change Password
      </h1>

      <p class="page-description">
        Update your faculty account password.
      </p>


      <div class="card form-card">

        <div class="form-group">

          <label>
            Current Password
          </label>

          <input
            type="password"
            id="currentPassword"
            class="form-control"
            placeholder="Current password"
          >

        </div>


        <div class="form-group">

          <label>
            New Password
          </label>

          <input
            type="password"
            id="newPassword"
            class="form-control"
            placeholder="New password"
          >

        </div>


        <div class="form-group">

          <label>
            Confirm Password
          </label>

          <input
            type="password"
            id="confirmPassword"
            class="form-control"
            placeholder="Confirm new password"
          >

        </div>


        <button
          type="button"
          class="btn-primary"
          onclick="alert('Password change API is not connected yet.')"
        >

          <i class="fas fa-key"></i>

          Update Password

        </button>

      </div>

    </section>


  </main>

</div>



<!-- ========================================= -->
<!-- JAVASCRIPT -->
<!-- ========================================= -->

<script>

(function () {

  const navItems =
    document.querySelectorAll(
      ".nav-item[data-view]"
    );


  const actionButtons =
    document.querySelectorAll(
      "[data-view]"
    );


  const views =
    document.querySelectorAll(
      ".view"
    );


  function openView(viewId) {

    views.forEach(function (view) {

      view.classList.remove(
        "active-view"
      );

    });


    navItems.forEach(function (item) {

      item.classList.remove(
        "active"
      );

    });


    const target =
      document.getElementById(
        viewId
      );


    if (target) {

      target.classList.add(
        "active-view"
      );

    }


    navItems.forEach(function (item) {

      if (
        item.dataset.view ===
        viewId
      ) {

        item.classList.add(
          "active"
        );

      }

    });


    window.scrollTo({
      top: 0,
      behavior: "smooth"
    });

  }


  actionButtons.forEach(function (button) {

    button.addEventListener(
      "click",
      function () {

        const viewId =
          button.dataset.view;


        if (viewId) {

          openView(viewId);

        }

      }
    );

  });


})();

</script>


</body>

</html>