<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>My Fees - ERP</title>

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >

  <style>

    body {
      background: #f5f7fb;
    }

    .page-title {
      font-weight: 700;
    }

    .summary-card {
      border: none;
      border-radius: 12px;
      box-shadow: 0 3px 12px rgba(0, 0, 0, 0.08);
    }

    .fee-card {
      border: none;
      border-radius: 12px;
      box-shadow: 0 3px 12px rgba(0, 0, 0, 0.08);
    }

    .amount {
      font-size: 24px;
      font-weight: 700;
    }

    .table th {
      white-space: nowrap;
    }

  </style>

</head>


<body>


<div class="container py-4">


  <!-- HEADER -->

  <div class="d-flex justify-content-between align-items-center mb-4">

    <div>

      <h2 class="page-title mb-1">
        My Fees
      </h2>

      <p class="text-muted mb-0">
        Student Fee Details & Payment History
      </p>

    </div>


    <a
      href="/erp/students/dashboard"
      class="btn btn-primary"
    >
      Back to Dashboard
    </a>

  </div>



  <!-- STUDENT INFORMATION -->

  <div class="card fee-card mb-4">

    <div class="card-body">

      <div class="row">


        <div class="col-md-3 mb-3">

          <small class="text-muted">
            Student Name
          </small>

          <div class="fw-bold">
            <%= user?.name || "N/A" %>
          </div>

        </div>


        <div class="col-md-3 mb-3">

          <small class="text-muted">
            Enrollment No.
          </small>

          <div class="fw-bold">
            <%= user?.enrollment || "N/A" %>
          </div>

        </div>


        <div class="col-md-3 mb-3">

          <small class="text-muted">
            Session
          </small>

          <div class="fw-bold">
            <%= user?.session || "N/A" %>
          </div>

        </div>


        <div class="col-md-3 mb-3">

          <small class="text-muted">
            Course
          </small>

          <div class="fw-bold">
            D.Pharm
          </div>

        </div>


      </div>

    </div>

  </div>



  <!-- SUMMARY -->

  <div class="row g-3 mb-4">


    <div class="col-md-4">

      <div class="card summary-card">

        <div class="card-body">

          <div class="text-muted">
            Total Fees
          </div>

          <div class="amount text-primary">

            ₹<%= Number(
              summary?.totalFees || 0
            ).toLocaleString("en-IN") %>

          </div>

        </div>

      </div>

    </div>



    <div class="col-md-4">

      <div class="card summary-card">

        <div class="card-body">

          <div class="text-muted">
            Paid Fees
          </div>

          <div class="amount text-success">

            ₹<%= Number(
              summary?.paidFees || 0
            ).toLocaleString("en-IN") %>

          </div>

        </div>

      </div>

    </div>



    <div class="col-md-4">

      <div class="card summary-card">

        <div class="card-body">

          <div class="text-muted">
            Pending Fees
          </div>

          <div class="amount text-danger">

            ₹<%= Number(
              summary?.pendingFees || 0
            ).toLocaleString("en-IN") %>

          </div>

        </div>

      </div>

    </div>


  </div>



  <!-- SEMESTER WISE FEES -->

  <div class="card fee-card">

    <div class="card-header bg-white">

      <h5 class="mb-0">
        Semester-wise Fees
      </h5>

    </div>


    <div class="card-body">


      <% if (!fees || fees.length === 0) { %>


        <div class="text-center py-5">

          <h5 class="text-muted">
            No fee records found
          </h5>

          <p class="text-muted mb-0">
            Your fee details will appear here after the college adds them.
          </p>

        </div>


      <% } else { %>


        <% fees.forEach((fee) => { %>


          <div class="card border mb-4">

            <div class="card-body">


              <!-- SEMESTER HEADER -->

              <div class="d-flex justify-content-between align-items-center mb-3">

                <h5 class="mb-0">
                  <%= fee.semester %>
                </h5>


                <% if (fee.status === "Paid") { %>

                  <span class="badge bg-success">
                    Paid
                  </span>

                <% } else if (fee.status === "Partial") { %>

                  <span class="badge bg-warning text-dark">
                    Partial
                  </span>

                <% } else { %>

                  <span class="badge bg-danger">
                    Pending
                  </span>

                <% } %>


              </div>



              <!-- FEE SUMMARY -->

              <div class="row">


                <div class="col-md-4 mb-3">

                  <small class="text-muted">
                    Total Fees
                  </small>

                  <div class="fw-bold">

                    ₹<%= Number(
                      fee.totalFees || 0
                    ).toLocaleString("en-IN") %>

                  </div>

                </div>



                <div class="col-md-4 mb-3">

                  <small class="text-muted">
                    Paid
                  </small>

                  <div class="fw-bold text-success">

                    ₹<%= Number(
                      fee.paidFees || 0
                    ).toLocaleString("en-IN") %>

                  </div>

                </div>



                <div class="col-md-4 mb-3">

                  <small class="text-muted">
                    Pending
                  </small>

                  <div class="fw-bold text-danger">

                    ₹<%= Number(
                      fee.pendingFees || 0
                    ).toLocaleString("en-IN") %>

                  </div>

                </div>


              </div>



              <!-- PAYMENT HISTORY -->

              <% if (
                fee.payments &&
                fee.payments.length > 0
              ) { %>


                <hr>


                <h6 class="mb-3">
                  Payment History
                </h6>


                <div class="table-responsive">

                  <table class="table table-bordered table-hover align-middle">


                    <thead class="table-light">

                      <tr>

                        <th>
                          Receipt No.
                        </th>

                        <th>
                          Amount
                        </th>

                        <th>
                          Payment Mode
                        </th>

                        <th>
                          Transaction ID
                        </th>

                        <th>
                          Payment Date
                        </th>

                        <th>
                          Status
                        </th>

                        <th>
                          Receipt
                        </th>

                      </tr>

                    </thead>



                    <tbody>


                      <% fee.payments.forEach(
                        (payment) => {
                      %>


                        <tr>


                          <!-- RECEIPT NUMBER -->

                          <td>

                            <strong>
                              <%= payment.receiptNo %>
                            </strong>

                          </td>



                          <!-- AMOUNT -->

                          <td>

                            ₹<%= Number(
                              payment.amount || 0
                            ).toLocaleString("en-IN") %>

                          </td>



                          <!-- PAYMENT MODE -->

                          <td>

                            <%= payment.paymentMode || "-" %>

                          </td>



                          <!-- TRANSACTION ID -->

                          <td>

                            <%= payment.transactionId || "-" %>

                          </td>



                          <!-- PAYMENT DATE -->

                          <td>

                            <%= payment.paymentDate
                              ? new Date(
                                  payment.paymentDate
                                ).toLocaleDateString("en-IN")
                              : "-"
                            %>

                          </td>



                          <!-- STATUS -->

                          <td>


                            <% if (
                              payment.status === "SUCCESS"
                            ) { %>

                              <span class="badge bg-success">
                                SUCCESS
                              </span>


                            <% } else if (
                              payment.status === "PENDING"
                            ) { %>

                              <span class="badge bg-warning text-dark">
                                PENDING
                              </span>


                            <% } else { %>

                              <span class="badge bg-danger">
                                FAILED
                              </span>

                            <% } %>


                          </td>



                          <!-- VIEW RECEIPT -->

                          <td>

                            <a
                              href="/erp/students/fees/receipt/<%= encodeURIComponent(payment.receiptNo) %>"
                              class="btn btn-sm btn-primary"
                              target="_blank"
                            >
                              View Receipt
                            </a>

                          </td>


                        </tr>


                      <% }) %>


                    </tbody>


                  </table>

                </div>


              <% } else { %>


                <div class="text-muted mt-3">

                  No payment history available.

                </div>


              <% } %>


            </div>

          </div>


        <% }) %>


      <% } %>


    </div>

  </div>


</div>


</body>

</html>