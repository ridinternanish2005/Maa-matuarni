<script>

function openQuestionPapers() {

  window.location.href =
    "/erp/students/question-papers";

}

function openMyLibrary() {

  window.location.href =
    "/erp/students/my-library";

}

(function () {

  "use strict";


  /* ========================================================
     SIDEBAR NAVIGATION
     ======================================================== */

  const navItems =
    document.querySelectorAll(".nav-item");

  const views =
    document.querySelectorAll(".view");


  function activateView(viewId) {

    views.forEach(function (view) {

      view.classList.remove(
        "active-view"
      );

    });


    const activeView =
      document.getElementById(viewId);


    if (activeView) {

      activeView.classList.add(
        "active-view"
      );

    }

  }


  navItems.forEach(function (item) {

    item.addEventListener(
      "click",
      function () {

        navItems.forEach(
          function (nav) {

            nav.classList.remove(
              "active"
            );

          }
        );


        this.classList.add(
          "active"
        );


        const viewId =
          this.getAttribute(
            "data-view"
          );


        if (viewId) {

          activateView(
            viewId
          );


          /* Load result only when clicked */

          if (
            viewId ===
            "testResultView"
          ) {

            loadStudentResults();

          }

        }

      }
    );

  });

// ==========================================
// BOOK SEARCH
// ==========================================
window.searchBooks = async function () {

  const input =
    document.getElementById("bookSearchInput");

  const results =
    document.getElementById("bookSearchResults");

  const search =
    input.value.trim();


  if (!search) {

    results.innerHTML = `
      <div style="
        text-align:center;
        padding:20px;
        color:#666;
      ">
        Please enter book name, author or ISBN.
      </div>
    `;

    return;
  }


  results.innerHTML = `
    <div style="
      text-align:center;
      padding:20px;
    ">
      <i class="fas fa-spinner fa-spin"></i>
      Searching...
    </div>
  `;


  try {

    const response = await fetch(
      "/erp/library/search?search=" +
      encodeURIComponent(search)
    );

    const data = await response.json();


    if (!data.success) {

      results.innerHTML = `
        <div style="
          text-align:center;
          padding:20px;
          color:red;
        ">
          ${data.message || "Unable to search books."}
        </div>
      `;

      return;
    }


    if (!data.books || data.books.length === 0) {

      results.innerHTML = `
        <div style="
          text-align:center;
          padding:20px;
          color:#666;
        ">

          <i class="fas fa-book-open"></i>

          No books found.

        </div>
      `;

      return;
    }


    let html = `
      <div style="
        display:grid;
        gap:15px;
      ">
    `;


    data.books.forEach(book => {

      const available =
        Number(book.availableCopies || 0);


      html += `

        <div style="
          border:1px solid #ddd;
          border-radius:8px;
          padding:18px;
          background:#fff;
        ">

          <div style="
            font-size:18px;
            font-weight:600;
            color:#1e4a6b;
            margin-bottom:8px;
          ">

            <i class="fas fa-book"></i>

            ${book.bookName}

          </div>


          <div style="
            color:#555;
            line-height:1.8;
          ">

            <div>
              <strong>Author:</strong>
              ${book.author || "-"}
            </div>

            <div>
              <strong>ISBN:</strong>
              ${book.isbn || "-"}
            </div>

            <div>
              <strong>Category:</strong>
              ${book.category || "-"}
            </div>

            <div>
              <strong>Publisher:</strong>
              ${book.publisher || "-"}
            </div>

            <div>
              <strong>Total Copies:</strong>
              ${book.quantity}
            </div>

            <div>
              <strong>Available Copies:</strong>

              ${
                available > 0
                ? `<span style="color:green;font-weight:bold;">
                     ${available} Available
                   </span>`
                : `<span style="color:red;font-weight:bold;">
                     Not Available
                   </span>`
              }

            </div>

          </div>

        </div>

      `;

    });


    html += `</div>`;

    results.innerHTML = html;


  } catch (error) {

    console.error(
      "Book Search Error:",
      error
    );

    results.innerHTML = `
      <div style="
        text-align:center;
        padding:20px;
        color:red;
      ">
        Unable to search books.
      </div>
    `;

  }

}
  /* ========================================================
     STUDENT RESULT
     ======================================================== */

  async function loadStudentResults() {

    const loading =
      document.getElementById(
        "resultLoading"
      );

    const content =
      document.getElementById(
        "resultContent"
      );

    const error =
      document.getElementById(
        "resultError"
      );


    if (
      !loading ||
      !content ||
      !error
    ) {

      return;

    }


    loading.style.display =
      "block";

    content.style.display =
      "none";

    error.style.display =
      "none";


    try {

      const response =
        await fetch(
          "/erp/students/results/data"
        );


      const data =
        await response.json();


      if (
        !response.ok ||
        !data.success
      ) {

        throw new Error(
          data.message ||
          "Unable to load results."
        );

      }


      loading.style.display =
        "none";

      content.style.display =
        "block";


      /* -----------------------------------------
         NO RESULT
         ----------------------------------------- */

      if (
        !data.marks ||
        data.marks.length === 0
      ) {

        content.innerHTML = `

          <div class="info-message">

            <strong>
              No Result Available
            </strong>

            <br>

            Your test result has not
            been uploaded yet.

          </div>

        `;

        return;

      }


      /* -----------------------------------------
         RESULT ROWS
         ----------------------------------------- */

      let rows = "";


      data.marks.forEach(
        function (mark) {

          const maxMarks =
            Number(
              mark.maxMarks || 0
            );


          const obtainedMarks =
            Number(
              mark.marks || 0
            );


          const percentage =
            maxMarks > 0
              ? (
                  obtainedMarks /
                  maxMarks
                ) * 100
              : 0;


          let grade = "F";


          if (percentage >= 90) {

            grade = "A+";

          } else if (
            percentage >= 80
          ) {

            grade = "A";

          } else if (
            percentage >= 70
          ) {

            grade = "B+";

          } else if (
            percentage >= 60
          ) {

            grade = "B";

          } else if (
            percentage >= 50
          ) {

            grade = "C";

          } else if (
            percentage >= 40
          ) {

            grade = "D";

          }


          const status =
            percentage >= 40
              ? "Pass"
              : "Fail";


          rows += `

            <tr>

              <td>
                ${mark.subject || "-"}
              </td>

              <td>
                ${mark.examType || "-"}
              </td>

              <td>
                ${obtainedMarks}
              </td>

              <td>
                ${maxMarks}
              </td>

              <td>
                ${percentage.toFixed(2)}%
              </td>

              <td>
                ${grade}
              </td>

              <td>
                ${status}
              </td>

            </tr>

          `;

        }
      );


      /* -----------------------------------------
         RESULT CONTENT
         ----------------------------------------- */

      const student =
        data.student || {};


      content.innerHTML = `

        <div
          class="info-message"
          style="margin-bottom:20px;"
        >

          <strong>
            ${student.name || "-"}
          </strong>

          <br>

          Enrollment:
          ${student.enrollment || "-"}

          <br>

          Course:
          ${student.course || "D.Pharm"}

          <br>

          Semester:
          ${student.semester || "1st Semester"}

          <br>

          Session:
          ${student.session || "-"}

        </div>


        <div class="table-responsive">

          <table>

            <thead>

              <tr>

                <th>
                  Subject
                </th>

                <th>
                  Exam Type
                </th>

                <th>
                  Obtained
                </th>

                <th>
                  Max Marks
                </th>

                <th>
                  Percentage
                </th>

                <th>
                  Grade
                </th>

                <th>
                  Status
                </th>

              </tr>

            </thead>


            <tbody>

              ${rows}

            </tbody>

          </table>

        </div>


        <div
          class="stats-grid"
          style="margin-top:25px;"
        >

          <div class="stat-card">

            <div class="stat-label">
              Total Marks
            </div>

            <div class="stat-number">
              ${data.totalMaxMarks || 0}
            </div>

          </div>


          <div class="stat-card">

            <div class="stat-label">
              Obtained Marks
            </div>

            <div class="stat-number">
              ${data.totalObtainedMarks || 0}
            </div>

          </div>


          <div class="stat-card">

            <div class="stat-label">
              Percentage
            </div>

            <div class="stat-number">
              ${data.percentage || "0.00"}%
            </div>

          </div>

        </div>

      `;

    }

    catch (err) {

      console.error(
        "Result Loading Error:",
        err
      );


      loading.style.display =
        "none";


      error.style.display =
        "block";


      error.textContent =
        "Unable to load result. Please try again.";

    }

  }


  /* ========================================================
     GO BUTTON
     ======================================================== */

  const goBtn =
    document.getElementById(
      "goBtn"
    );


  if (goBtn) {

    goBtn.addEventListener(
      "click",
      function (event) {

        event.preventDefault();


        alert(
          "ERP session " +
          "<%= erpUser?.session || 'N/A' %>" +
          " · Student Dashboard"
        );

      }
    );

  }


  /* ========================================================
     NOTICE HIGHLIGHT
     ======================================================== */

  const noticeRows =
    document.querySelectorAll(
      "#noticeTableBody tr"
    );


  let currentNoticeIndex = 0;


  const totalNotices =
    noticeRows.length;


  function clearHighlight() {

    noticeRows.forEach(
      function (row) {

        row.classList.remove(
          "note-highlight"
        );

      }
    );

  }


  function updateNoticeDisplay(
    index
  ) {

    if (
      totalNotices === 0
    ) {

      return;

    }


    index =
      (
        index %
        totalNotices +
        totalNotices
      ) %
      totalNotices;


    currentNoticeIndex =
      index;


    clearHighlight();


    if (
      noticeRows[
        currentNoticeIndex
      ]
    ) {

      noticeRows[
        currentNoticeIndex
      ].classList.add(
        "note-highlight"
      );

    }

  }


  if (
    totalNotices > 0
  ) {

    updateNoticeDisplay(0);

  }

})();

</script>

</body>

</html>