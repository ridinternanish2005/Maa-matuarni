<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Access Denied</title>
  <style>
    body{font-family:Arial,sans-serif;display:flex;align-items:center;justify-content:center;min-height:100vh;margin:0;background:#f5f7fb;color:#222}
    .box{background:#fff;padding:40px;border-radius:14px;box-shadow:0 10px 30px rgba(0,0,0,.08);text-align:center;max-width:450px}
    h1{margin-top:0;color:#b42318}.btn{display:inline-block;margin-top:20px;padding:12px 20px;background:#203a43;color:#fff;text-decoration:none;border-radius:8px}
  </style>
</head>
<body>
  <div class="box">
    <h1>Access Denied</h1>
    <p>You are not authorized to access this ERP section.</p>
    <a class="btn" href="/erp/<%= user.role %>">Go to My Dashboard</a>
    <a class="btn" href="/erp/logout">Logout</a>
  </div>
</body>
</html>
