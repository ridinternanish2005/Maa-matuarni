<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>Faculty Management</title>


  <style>

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      padding: 30px;
      font-family: Arial, sans-serif;
      background: #f5f7fb;
    }

    .container {
      max-width: 1200px;
      margin: auto;
    }

    .card {
      background: white;
      padding: 25px;
      border-radius: 12px;
      margin-bottom: 25px;
      box-shadow: 0 3px 12px rgba(0,0,0,0.08);
    }

    h1 {
      margin-top: 0;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 15px;
    }

    .full {
      grid-column: 1 / -1;
    }

    label {
      font-weight: bold;
      display: block;
    }

    input,
    select,
    textarea {
      width: 100%;
      padding: 11px;
      margin-top: 7px;
      border: 1px solid #ddd;
      border-radius: 7px;
    }

    textarea {
      min-height: 90px;
      resize: vertical;
    }

    button {
      border: none;
      padding: 11px 18px;
      border-radius: 7px;
      cursor: pointer;
      color: white;
      background: #2563eb;
    }

    .save-btn {
      margin-top: 15px;
    }

    .status-btn {
      background: #dc2626;
    }

    .subject-btn {
      background: #16a34a;
      margin-left: 5px;
    }

    table {
      width: 100%;
      border-collapse: collapse;
    }

    th,
    td {
      padding: 12px;
      border-bottom: 1px solid #eee;
      text-align: left;
      vertical-align: middle;
    }

    th {
      background: #f1f5f9;
    }

    .active {
      color: green;
      font-weight: bold;
    }

    .inactive {
      color: red;
      font-weight: bold;
    }

    .message {
      margin-top: 15px;
      font-weight: bold;
    }

    .modal {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.5);
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    .modal-box {
      background: white;
      width: 100%;
      max-width: 500px;
      padding: 25px;
      border-radius: 12px;
    }

    .modal-actions {
      margin-top: 20px;
      display: flex;
      gap: 10px;
    }

    .cancel-btn {
      background: #64748b;
    }

    .small-text {
      color: #666;
      font-size: 13px;
      margin-top: 6px;
    }

    @media (max-width: 700px) {

      .grid {
        grid-template-columns: 1fr;
      }

      .full {
        grid-column: auto;
      }

      table {
        font-size: 13px;
      }

    }

  </style>

</head>


<body>
<%
  const safeFacultyList =
    typeof facultyList !== "undefined" && Array.isArray(facultyList)
      ? facultyList
      : [];
%>

<div class="container">


  <h1>Faculty Management</h1>


  <!-- ==========================================
       ADD FACULTY PROFILE
  =========================================== -->

  <div class="card">

    <h2>Add Faculty Profile</h2>


    <form id="facultyForm">

      <div class="grid">


        <!-- FACULTY -->

        <div class="full">

          <label>
            Select Faculty
          </label>

          <select
            name="userId"
            id="userId"
            required
          >

            <option value="">
              Select Faculty
            </option>

          <% safeFacultyList.forEach(function(faculty) { %>

              <% if (!faculty.profile) { %>

                <option value="<%= faculty._id %>">
                  <%= faculty.name %> -
                  <%= faculty.enrollment %>
                </option>

              <% } %>

            <% }); %>

          </select>

          <div class="small-text">
            Sirf wahi faculty dikhenge jinka profile abhi create nahi hua hai.
          </div>

        </div>


        <!-- DEPARTMENT -->

        <div>

          <label>
            Department
          </label>

          <input
            type="text"
            name="department"
            value="Pharmacy"
            required
          >

        </div>


        <!-- DESIGNATION -->

        <div>

          <label>
            Designation
          </label>

          <input
            type="text"
            name="designation"
            value="Faculty"
          >

        </div>


        <!-- QUALIFICATION -->

        <div>

          <label>
            Qualification
          </label>

          <input
            type="text"
            name="qualification"
            placeholder="B.Pharm / M.Pharm"
          >

        </div>


        <!-- MOBILE -->

        <div>

          <label>
            Mobile
          </label>

          <input
            type="text"
            name="mobile"
            placeholder="Mobile Number"
          >

        </div>


        <!-- EMAIL -->

        <div>

          <label>
            Email
          </label>

          <input
            type="email"
            name="email"
            placeholder="faculty@example.com"
          >

        </div>


        <!-- SUBJECTS -->

        <div class="full">

          <label>
            Subjects
          </label>

          <textarea
            name="subjects"
            placeholder="Pharmaceutics, Pharmacology, Pharmaceutical Chemistry"
          ></textarea>

          <div class="small-text">
            Multiple subjects comma se separate karo.
          </div>

        </div>


      </div>


      <button
        type="submit"
        class="save-btn"
      >
        Save Faculty Profile
      </button>


    </form>


    <p
      id="message"
      class="message"
    ></p>

  </div>



  <!-- ==========================================
       FACULTY LIST
  =========================================== -->

  <div class="card">

    <h2>Faculty List</h2>


    <table>

      <thead>

        <tr>

          <th>Name</th>

          <th>Enrollment</th>

          <th>Department</th>

          <th>Designation</th>

          <th>Subjects</th>

          <th>Status</th>

          <th>Action</th>

        </tr>

      </thead>


      <tbody>

       <% if (safeFacultyList.length === 0) { %>

          <tr>

            <td colspan="7">
              No faculty found.
            </td>

          </tr>

        <% } else { %>


        <% safeFacultyList.forEach(function(faculty) { %>

            <tr>

              <td>
                <%= faculty.name %>
              </td>


              <td>
                <%= faculty.enrollment %>
              </td>


              <td>

                <%= faculty.profile
                  ? faculty.profile.department
                  : "Not Added" %>

              </td>


              <td>

                <%= faculty.profile
                  ? faculty.profile.designation
                  : "Not Added" %>

              </td>


              <td>

            <% if (
  faculty.profile &&
  faculty.profile.assignedSubjects &&
  faculty.profile.assignedSubjects.length > 0
) { %>

              <%= faculty.profile?.assignedSubjects?.length
  ? faculty.profile.assignedSubjects
      .map(subject => `${subject.name} (${subject.code})`)
      .join(", ")
  : "No subjects assigned" %>

                <% } else { %>

                  <span style="color:#777;">
                    Not Assigned
                  </span>

                <% } %>

              </td>


              <td>

                <% if (faculty.active) { %>

                  <span class="active">
                    Active
                  </span>

                <% } else { %>

                  <span class="inactive">
                    Inactive
                  </span>

                <% } %>

              </td>


              <td>

                <button
                  class="status-btn"
                  onclick="toggleFaculty('<%= faculty._id %>')"
                >

                  <%= faculty.active
                    ? "Deactivate"
                    : "Activate" %>

                </button>


                <% if (faculty.profile) { %>

     

<button
  type="button"
  class="subject-btn"
  data-profile-id="<%= faculty.profile._id %>"
  data-faculty-name="<%= faculty.name %>"
  onclick="openSubjectModal(this.dataset.profileId, this.dataset.facultyName)"
>
  Subjects
</button>



                <% } %>

              </td>

            </tr>

          <% }); %>

        <% } %>

      </tbody>

    </table>

  </div>


</div>



<!-- ==========================================
     SUBJECT MODAL
=========================================== -->

<div id="subjectModal" class="modal">

  <div class="modal-box">

    <h2>Assign Subjects</h2>

    <p id="selectedFaculty"></p>

    <input
      type="hidden"
      id="selectedProfileId"
    >

    <!-- Course -->
    <label for="assignmentCourse">
      Course
    </label>

    <select id="assignmentCourse">
      <option value="">Select Course</option>
    </select>


    <!-- Semester -->
    <label for="assignmentSemester">
      Semester
    </label>

    <select
      id="assignmentSemester"
      disabled
    >
      <option value="">Select Semester</option>
    </select>


    <!-- Subject -->
    <label for="assignmentSubject">
      Subject
    </label>

    <select
      id="assignmentSubject"
      disabled
    >
      <option value="">Select Subject</option>
    </select>


    <button
      type="button"
      onclick="addSelectedSubject()"
    >
      + Add Subject
    </button>


    <!-- Selected Subjects -->
    <div class="small-text">
      Selected Subjects
    </div>

    <div id="selectedSubjectsList">
      No subjects selected.
    </div>


    <div class="modal-actions">

      <button
        type="button"
        onclick="saveSubjects()"
      >
        Save Subjects
      </button>

      <button
        type="button"
        class="cancel-btn"
        onclick="closeSubjectModal()"
      >
        Cancel
      </button>

    </div>


    <p
      id="subjectMessage"
      class="message"
    ></p>

  </div>

</div>

<script>

// ==========================================
// CREATE FACULTY PROFILE
// ==========================================

document
  .getElementById("facultyForm")
  .addEventListener("submit", async function (event) {

    event.preventDefault();

    const formData = new FormData(this);

    const body = Object.fromEntries(formData.entries());

    try {

      const response = await fetch(
        "/erp/faculty-management",
        {
          method: "POST",

          headers: {
            "Content-Type": "application/json"
          },

          body: JSON.stringify(body)
        }
      );

      const data = await response.json();

      document.getElementById("message").textContent =
        data.message;

      if (data.success) {

        alert("Faculty profile created successfully.");

        this.reset();

        window.location.reload();
      }

    } catch (error) {

      console.error(error);

      document.getElementById("message").textContent =
        "Something went wrong.";
    }

});


// ==========================================
// ACTIVATE / DEACTIVATE FACULTY
// ==========================================

async function toggleFaculty(id) {

  try {

    const response = await fetch(
      `/erp/faculty-management/${id}/status`,
      {
        method: "PATCH"
      }
    );

    const data = await response.json();

    alert(data.message);

    if (data.success) {

      window.location.reload();

    }

  } catch (error) {

    console.error(error);

    alert("Unable to update faculty status.");
  }

}


// ==========================================
// FACULTY SUBJECT ASSIGNMENT
// ==========================================

let assignmentCourses = [];

let selectedSubjects = [];


// ==========================================
// LOAD COURSES
// ==========================================

async function loadAssignmentCourses() {

  try {

    const response = await fetch(
      "/erp/faculty-management/assignment-courses"
    );

    const data = await response.json();

    if (!data.success) {

      throw new Error(data.message);

    }

    assignmentCourses = data.courses || [];

    const courseSelect =
      document.getElementById("assignmentCourse");

    courseSelect.innerHTML =
      `<option value="">Select Course</option>`;

    assignmentCourses.forEach(course => {

      const option =
        document.createElement("option");

      option.value = course._id;

      option.textContent =
        `${course.courseCode} - ${course.courseName}`;

      courseSelect.appendChild(option);

    });

  } catch (error) {

    console.error(
      "Load Assignment Courses Error:",
      error
    );

    document.getElementById(
      "subjectMessage"
    ).textContent =
      "Unable to load courses.";

  }

}


// ==========================================
// COURSE CHANGE
// ==========================================

document
  .getElementById("assignmentCourse")
  .addEventListener("change", function () {

    const courseId = this.value;

    const semesterSelect =
      document.getElementById("assignmentSemester");

    const subjectSelect =
      document.getElementById("assignmentSubject");


    semesterSelect.innerHTML =
      `<option value="">Select Semester</option>`;

    subjectSelect.innerHTML =
      `<option value="">Select Subject</option>`;


    subjectSelect.disabled = true;


    if (!courseId) {

      semesterSelect.disabled = true;

      return;
    }


    const course =
      assignmentCourses.find(
        item => item._id === courseId
      );


    if (!course) {

      semesterSelect.disabled = true;

      return;
    }


    course.semesters.forEach(semester => {

      if (!semester.active) return;


      const option =
        document.createElement("option");


      option.value =
        semester._id;


      option.textContent =
        semester.name;


      semesterSelect.appendChild(option);

    });


    semesterSelect.disabled = false;

});


// ==========================================
// SEMESTER CHANGE
// ==========================================

document
  .getElementById("assignmentSemester")
  .addEventListener("change", function () {

    const courseId =
      document.getElementById(
        "assignmentCourse"
      ).value;


    const semesterId =
      this.value;


    const subjectSelect =
      document.getElementById(
        "assignmentSubject"
      );


    subjectSelect.innerHTML =
      `<option value="">Select Subject</option>`;


    if (!courseId || !semesterId) {

      subjectSelect.disabled = true;

      return;
    }


    const course =
      assignmentCourses.find(
        item => item._id === courseId
      );


    if (!course) return;


    const semester =
      course.semesters.find(
        item => item._id === semesterId
      );


    if (!semester) return;


    semester.subjects.forEach(subject => {

      if (!subject.active) return;


      const option =
        document.createElement("option");


      option.value =
        subject._id;


      option.textContent =
        `${subject.name} (${subject.code})`;


      subjectSelect.appendChild(option);

    });


    subjectSelect.disabled = false;

});


// ==========================================
// ADD SELECTED SUBJECT
// ==========================================

function addSelectedSubject() {

  const courseId =
    document.getElementById(
      "assignmentCourse"
    ).value;


  const semesterId =
    document.getElementById(
      "assignmentSemester"
    ).value;


  const subjectId =
    document.getElementById(
      "assignmentSubject"
    ).value;


  if (
    !courseId ||
    !semesterId ||
    !subjectId
  ) {

    alert(
      "Please select Course, Semester and Subject."
    );

    return;
  }


  const course =
    assignmentCourses.find(
      item => item._id === courseId
    );


  if (!course) return;


  const semester =
    course.semesters.find(
      item => item._id === semesterId
    );


  if (!semester) return;


  const subject =
    semester.subjects.find(
      item => item._id === subjectId
    );


  if (!subject) return;


  const alreadyAdded =
    selectedSubjects.some(
      item =>
        item.name === subject.name &&
        item.code === subject.code
    );


  if (alreadyAdded) {

    alert("Subject already added.");

    return;
  }


  selectedSubjects.push({

    subjectId: subject._id,

    courseId: course._id,

    semesterId: semester._id,

    name: subject.name,

    code: subject.code

  });


  renderSelectedSubjects();

}


// ==========================================
// SHOW SELECTED SUBJECTS
// ==========================================

function renderSelectedSubjects() {

  const container =
    document.getElementById(
      "selectedSubjectsList"
    );


  if (selectedSubjects.length === 0) {

    container.innerHTML =
      "No subjects selected.";

    return;
  }


  container.innerHTML =
    selectedSubjects
      .map((subject, index) => {

        return `

          <div
            class="selected-subject-item"
            style="
              display:flex;
              justify-content:space-between;
              align-items:center;
              padding:8px;
              margin-top:6px;
              border:1px solid #ddd;
              border-radius:6px;
            "
          >

            <span>
              ${subject.name}
              ${subject.code
                ? `(${subject.code})`
                : ""}
            </span>


            <button
              type="button"
              onclick="removeSelectedSubject(${index})"
              style="
                background:#dc2626;
                padding:5px 10px;
              "
            >
              Remove
            </button>

          </div>

        `;

      })
      .join("");

}


// ==========================================
// REMOVE SUBJECT
// ==========================================

function removeSelectedSubject(index) {

  selectedSubjects.splice(index, 1);

  renderSelectedSubjects();

}


// ==========================================
// OPEN SUBJECT MODAL
// ==========================================


 // ==========================================
 // OPEN SUBJECT MODAL
 // ==========================================

function openSubjectModal(profileId, facultyName) {
  selectedSubjects = [];

  document.getElementById("selectedProfileId").value = profileId;

  document.getElementById("selectedFaculty").textContent =
    "Faculty: " + facultyName;

  document.getElementById("subjectMessage").textContent = "";

  renderSelectedSubjects();

  document.getElementById("assignmentCourse").value = "";

  document.getElementById("assignmentSemester").innerHTML =
    '<option value="">Select Semester</option>';

  document.getElementById("assignmentSubject").innerHTML =
    '<option value="">Select Subject</option>';

  document.getElementById("assignmentSemester").disabled = true;
  document.getElementById("assignmentSubject").disabled = true;

  document.getElementById("subjectModal").style.display = "flex";

  loadAssignmentCourses();
}




// ==========================================
// CLOSE SUBJECT MODAL
// ==========================================

function closeSubjectModal() {

  document.getElementById(
    "subjectModal"
  ).style.display = "none";

}


// ==========================================
// SAVE SUBJECTS
// ==========================================



async function saveSubjects() {
  const profileId =
    document.getElementById("selectedProfileId").value;

  if (!profileId) {
    alert("Faculty profile not found.");
    return;
  }

  if (selectedSubjects.length === 0) {
    alert("Please select at least one subject.");
    return;
  }

  const subjectAssignments = selectedSubjects.map(subject => ({
    courseId: String(subject.courseId),
    semesterId: String(subject.semesterId),
    subjectId: String(subject.subjectId)
  }));

  const hasInvalidAssignment = subjectAssignments.some(subject =>
    !subject.courseId ||
    !subject.semesterId ||
    !subject.subjectId
  );

  if (hasInvalidAssignment) {
    alert("Course, Semester aur Subject dropdown se subjects select karein.");
    return;
  }

  try {
    const response = await fetch(
      `/erp/faculty-management/${profileId}/subjects`,
      {
        method: "PUT",
        headers: {
          "Content-Type": "application/json"
        },
        body: JSON.stringify({
          subjectAssignments
        })
      }
    );

    const data = await response.json();

    document.getElementById("subjectMessage").textContent =
      data.message || "Request completed.";

    if (!response.ok || !data.success) {
      alert(data.message || "Unable to assign subjects.");
      return;
    }

    alert("Subjects assigned successfully.");
    closeSubjectModal();
    window.location.reload();

  } catch (error) {
    console.error("Save Subjects Error:", error);
    alert("Unable to assign subjects. Check the terminal.");
  }
}


</script>

</body>

</html>