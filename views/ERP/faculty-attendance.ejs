<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>Faculty Attendance</title>


  <style>

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f5f7fb;
    }

    .container {
      max-width: 1200px;
      margin: auto;
      padding: 30px 20px;
    }

    .card {
      background: white;
      padding: 25px;
      border-radius: 12px;
      margin-bottom: 20px;
      box-shadow: 0 3px 12px rgba(0,0,0,.08);
    }

    h1 {
      margin-top: 0;
    }

    .form-grid {
      display: grid;
      grid-template-columns:
        repeat(2, 1fr);

      gap: 20px;
    }

    label {
      display: block;
      font-weight: bold;
      margin-bottom: 7px;
    }

    input,
    select {
      width: 100%;
      padding: 11px;
      border: 1px solid #ddd;
      border-radius: 7px;
    }

    button {
      border: none;
      padding: 11px 20px;
      border-radius: 7px;
      cursor: pointer;
      background: #2563eb;
      color: white;
      font-size: 15px;
    }

    .save-btn {
      margin-top: 20px;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 20px;
    }

    th,
    td {
      padding: 12px;
      border-bottom: 1px solid #eee;
      text-align: left;
    }

    th {
      background: #f1f5f9;
    }

    .status-select {
      padding: 8px;
      border-radius: 6px;
      border: 1px solid #ddd;
    }

    .message {
      margin-top: 15px;
      font-weight: bold;
    }

    .info {
      background: #eff6ff;
      padding: 15px;
      border-radius: 8px;
      margin-bottom: 20px;
    }

    @media(max-width: 700px) {

      .form-grid {
        grid-template-columns: 1fr;
      }

      table {
        font-size: 13px;
      }

    }

  </style>

</head>


<body>


<div class="container">


  <!-- HEADER -->

  <div class="card">

    <h1>
      👨‍🏫 Faculty Attendance
    </h1>

    <div class="info">

      <strong>
        Faculty:
      </strong>

      <%= faculty?.name || "Faculty" %>

      <br>

      <strong>
        Enrollment:
      </strong>

      <%= faculty?.enrollment || "N/A" %>

      <br>

      <strong>
        Session:
      </strong>

      <%= faculty?.session || "N/A" %>

    </div>


    <!-- FORM -->

    <div class="form-grid">


      <div>

        <label>
          Attendance Date
        </label>

        <input
          type="date"
          id="attendanceDate"
          required
        >

      </div>


      <div>

        <label>
          Subject
        </label>

        <select
          id="subject"
          required
        >

          <option value="">
            Select Subject
          </option>


          <% subjects.forEach(
            (subject) => {
          %>

            <option value="<%= subject %>">
              <%= subject %>
            </option>

          <% }) %>

        </select>

      </div>


    </div>


    <!-- STUDENT TABLE -->

    <h2>
      👨‍🎓 Student Attendance
    </h2>


    <% if (
      students &&
      students.length > 0
    ) { %>


      <table>

        <thead>

          <tr>

            <th>
              #
            </th>

            <th>
              Student Name
            </th>

            <th>
              Enrollment
            </th>

            <th>
              Status
            </th>

          </tr>

        </thead>


        <tbody>


          <% students.forEach(
            (student, index) => {
          %>


            <tr>

              <td>
                <%= index + 1 %>
              </td>


              <td>
                <%= student.name %>
              </td>


              <td>
                <%= student.enrollment %>
              </td>


              <td>

                <select
                  class="status-select"
                  data-enrollment="<%= student.enrollment %>"
                >

                  <option value="Present">
                    Present
                  </option>

                  <option value="Absent">
                    Absent
                  </option>

                  <option value="Leave">
                    Leave
                  </option>

                </select>

              </td>

            </tr>


          <% }) %>


        </tbody>

      </table>


      <button
        class="save-btn"
        onclick="saveAttendance()"
      >
        Save Attendance
      </button>


    <% } else { %>


      <p>
        No active students found for this session.
      </p>


    <% } %>


    <div
      id="message"
      class="message"
    ></div>


  </div>


</div>



<script>


// Today's date

const today =
  new Date()
    .toISOString()
    .split("T")[0];


document.getElementById(
  "attendanceDate"
).value = today;



async function saveAttendance() {

  const date =
    document.getElementById(
      "attendanceDate"
    ).value;


  const subject =
    document.getElementById(
      "subject"
    ).value;


  const message =
    document.getElementById(
      "message"
    );


  if (!date) {

    message.textContent =
      "Please select attendance date.";

    return;
  }


  if (!subject) {

    message.textContent =
      "Please select subject.";

    return;
  }


  const selects =
    document.querySelectorAll(
      ".status-select"
    );


  const attendance = [];


  selects.forEach(
    (select) => {

      attendance.push({

        enrollment:
          select.dataset.enrollment,

        status:
          select.value

      });

    }
  );


  try {

    const response =
      await fetch(
        "/erp/faculty/attendance",
        {
          method: "POST",

          headers: {
            "Content-Type":
              "application/json"
          },

          body: JSON.stringify({
            date,
            subject,
            attendance
          })
        }
      );


    const data =
      await response.json();


    message.textContent =
      data.message;


    if (data.success) {

      message.textContent =
        `Attendance saved successfully. ` +
        `New: ${data.savedCount}, ` +
        `Updated: ${data.updatedCount}`;

    }


  } catch (error) {

    console.error(error);

    message.textContent =
      "Server error. Please try again.";

  }

}


</script>


</body>

</html>